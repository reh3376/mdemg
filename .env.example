# MDEMG Service Configuration
# Copy this file to .env and fill in your values

# Neo4j Connection (required)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_password_here

# Schema version (required - must match applied migrations)
# Run `ls migrations/V*.cypher | wc -l` to find the current version
REQUIRED_SCHEMA_VERSION=17

# Service
LISTEN_ADDR=:9999

# Dynamic Port Allocation (optional)
# If LISTEN_ADDR port is busy, server scans this range for an available port.
# PORT_RANGE_START=9999         # Start of fallback range (default: derived from LISTEN_ADDR)
# PORT_RANGE_END=10099          # End of fallback range (default: PORT_RANGE_START + 100)
# PORT_FILE_PATH=.mdemg.port   # Port file for client discovery (default: .mdemg.port)

# Retrieval tuning
VECTOR_INDEX_NAME=memNodeEmbedding
DEFAULT_CANDIDATE_K=200
DEFAULT_TOP_K=20
DEFAULT_HOP_DEPTH=2
MAX_NEIGHBORS_PER_NODE=50
MAX_TOTAL_EDGES_FETCHED=5000
LEARNING_EDGE_CAP_PER_REQUEST=200

# Top-level LLM settings — cascade to all cognitive features
# (rerank, summary, synthesis, intent, emergence, guardrail)
# Per-feature overrides (e.g. SYNTHESIS_PROVIDER) still take precedence.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b-instruct-fp16

# Embedding Provider: "openai", "ollama", or "" (disabled)
EMBEDDING_PROVIDER=ollama

# OpenAI settings (only needed if using OpenAI for embeddings or LLM)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=text-embedding-3-small
OPENAI_ENDPOINT=https://api.openai.com/v1

# LLM_ENDPOINT — Override endpoint for all LLM text-generation calls
# (synthesis, intent translation, emergence naming, reranking).
# If unset, falls back to OPENAI_ENDPOINT.
# Use this to point LLM calls at a local MLX server while keeping
# OPENAI_ENDPOINT for embeddings.
# LLM_ENDPOINT=http://172.21.21.11:8080/v1

# Ollama settings (if EMBEDDING_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:4b

# Embedding Cache (LRU caching of embedding results)
EMBEDDING_CACHE_ENABLED=true   # Enable caching (default: true)
EMBEDDING_CACHE_SIZE=1000       # Max cached embeddings (default: 1000)
EMBEDDING_CACHE_DEBUG=false     # Enable debug logging for cache hits/misses (default: false)

# Temporal Retrieval (time-aware query understanding)
TEMPORAL_ENABLED=true           # Enable temporal query detection (default: true)
TEMPORAL_SOFT_BOOST=3.0         # Recency weight multiplier for soft-mode queries (default: 3.0, range: 1.0-10.0)
TEMPORAL_HARD_FILTER=true       # Enable hard time-range filtering (default: true)

# Linear Integration (for linear-module plugin)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_TEAM_ID=                 # Default team key for issue creation (e.g., "ENG")
LINEAR_WORKSPACE_ID=            # Workspace identifier (optional)

# ===== Phase 47: Optimistic Retry + Edge Consistency =====

# Optimistic Lock Retry Settings
# Enables retry with exponential backoff on version conflicts
OPTIMISTIC_RETRY_ENABLED=true           # Enable optimistic locking (default: true)
OPTIMISTIC_RETRY_MAX_ATTEMPTS=5         # Max retry attempts (default: 5)
OPTIMISTIC_RETRY_BASE_DELAY_MS=10       # Initial delay in ms (default: 10)
OPTIMISTIC_RETRY_MAX_DELAY_MS=1000      # Max delay in ms (default: 1000)
OPTIMISTIC_RETRY_MULTIPLIER=2.0         # Backoff multiplier (default: 2.0)

# Edge Staleness Cascade Settings
# Controls how edge updates cascade when node embeddings change
EDGE_STALENESS_CASCADE_ENABLED=true     # Enable staleness cascade (default: true)
EDGE_STALENESS_REFRESH_BATCH_SIZE=100   # Edges to refresh per call (default: 100)
EDGE_STALENESS_RECLUSTER_THRESHOLD=0.3  # Centroid drift for re-clustering (default: 0.3)

# ===== Phase 48: Data Transmission & Connection Pooling =====

# Embedding Rate Limiting (protects against provider rate limits)
EMBEDDING_RATE_LIMIT_ENABLED=false      # Enable rate limiting (default: false)
EMBEDDING_OPENAI_RPS=500                # OpenAI requests per second (default: 500)
EMBEDDING_OPENAI_BURST=1000             # OpenAI burst allowance (default: 1000)
EMBEDDING_OLLAMA_RPS=100                # Ollama requests per second (default: 100)
EMBEDDING_OLLAMA_BURST=200              # Ollama burst allowance (default: 200)

# Memory Pressure Backpressure (protects against OOM)
MEMORY_PRESSURE_ENABLED=false           # Enable memory backpressure (default: false)
MEMORY_PRESSURE_THRESHOLD_MB=4096       # Heap threshold in MB (default: 4096)

# ===== Phase 51: Web Scraper Ingestion =====

# Web Scraper Module Settings
SCRAPER_ENABLED=false                          # Enable web scraper module (default: false)
SCRAPER_DEFAULT_SPACE_ID=web-scraper           # Default target space for scraped content (default: web-scraper)
SCRAPER_MAX_CONCURRENT_JOBS=3                  # Max concurrent scrape jobs (default: 3)
SCRAPER_DEFAULT_DELAY_MS=1000                  # Delay between requests in ms (default: 1000)
SCRAPER_DEFAULT_TIMEOUT_MS=30000               # HTTP timeout per request in ms (default: 30000)
SCRAPER_CACHE_TTL_SECONDS=3600                 # robots.txt cache TTL in seconds (default: 3600)
SCRAPER_RESPECT_ROBOTS_TXT=true                # Respect robots.txt (default: true)
SCRAPER_MAX_CONTENT_LENGTH_KB=500              # Max content length in KB (default: 500)

# ===== Phase 70: Neo4j Backup & Restore =====

# Backup Module Settings
BACKUP_ENABLED=false                           # Enable backup module (default: false)
BACKUP_STORAGE_DIR=./backups                   # Directory for backup artifacts (default: ./backups)
BACKUP_FULL_CMD=docker                         # Command for full backups (default: docker)
BACKUP_NEO4J_CONTAINER=mdemg-neo4j             # Docker container name for Neo4j (default: mdemg-neo4j)
BACKUP_FULL_INTERVAL_HOURS=168                 # Hours between full backups (default: 168 = weekly)
BACKUP_PARTIAL_INTERVAL_HOURS=24               # Hours between partial backups (default: 24 = daily)
BACKUP_RETENTION_FULL_COUNT=4                  # Keep last N full backups (default: 4)
BACKUP_RETENTION_PARTIAL_COUNT=14              # Keep last N partial backups (default: 14)
BACKUP_RETENTION_MAX_AGE_DAYS=90               # Delete backups older than N days (default: 90)
BACKUP_RETENTION_MAX_STORAGE_GB=50             # Storage quota in GB (default: 50)
BACKUP_RETENTION_RUN_AFTER_BACKUP=true         # Run retention after each backup (default: true)

# ===== Phase 101: SME Synthesis Engine =====

# LLM-powered synthesis for the /v1/memory/consult endpoint
# When enabled and llm_synthesis=true in request, produces coherent SME narrative
# grounded exclusively in graph evidence (not general LLM knowledge)
SYNTHESIS_ENABLED=false                        # Enable LLM synthesis (default: false)
SYNTHESIS_PROVIDER=openai                      # LLM provider: openai or ollama (default: from LLM_PROVIDER)
SYNTHESIS_MODEL=gpt-4o-mini                    # Model for synthesis (default: from LLM_MODEL)
SYNTHESIS_MAX_TOKENS=2000                      # Max tokens for synthesis response (default: 2000, range: 100-8000)
SYNTHESIS_TIMEOUT_MS=30000                     # Timeout for synthesis call in ms (default: 30000, min: 1000)

# Intent Translation (Phase 102): LLM query rewriting before vector embedding
# When enabled and translate_intent=true in request, rewrites conversational queries
# into keyword-dense search strings optimized for vector similarity.
INTENT_ENABLED=false                           # Enable intent translation (default: false)
INTENT_PROVIDER=openai                         # LLM provider: openai or ollama (default: from LLM_PROVIDER)
INTENT_MODEL=gpt-4o-mini                       # Model for intent translation (default: from LLM_MODEL)
INTENT_MAX_TOKENS=150                          # Max tokens for rewritten query (default: 150, range: 10-500)
INTENT_TIMEOUT_MS=2000                         # Timeout for intent translation in ms (default: 2000, min: 200)

# Dynamic Emergence (Phase 103): LLM-driven concept naming for unclassified clusters
# When enabled and enable_dynamic_emergence=true in consolidate request, dense
# CO_ACTIVATED_WITH clusters that don't match hardcoded patterns are sent to an LLM
# for automatic naming and classification.
EMERGENCE_ENABLED=false                        # Enable dynamic emergence (default: false)
EMERGENCE_PROVIDER=openai                      # LLM provider: openai or ollama (default: from LLM_PROVIDER)
EMERGENCE_MODEL=gpt-4o-mini                    # Model for concept naming (default: from LLM_MODEL)
                                               # Ollama recommendation: llama3.2:3b (Q4_K_M) — fastest latency, top name quality
EMERGENCE_MAX_TOKENS=500                       # Max tokens for naming response (default: 500, range: 100-4000)
EMERGENCE_TIMEOUT_MS=10000                     # Timeout for naming call in ms (default: 10000, min: 1000)
EMERGENCE_MIN_WEIGHT=0.3                       # Min CO_ACTIVATED_WITH weight for clustering (default: 0.3, range: 0.0-1.0)
EMERGENCE_MIN_CLUSTER_SIZE=3                   # Min nodes per cluster (default: 3, min: 2)
EMERGENCE_MAX_CLUSTERS=10                      # Max clusters to name per run (default: 10, min: 1)

# --- Phase 104: Active MCP Guardrails ---
GUARDRAIL_ENABLED=false                        # Enable guardrail validation (default: false)
GUARDRAIL_PROVIDER=openai                      # LLM provider: openai or ollama (default: from LLM_PROVIDER)
GUARDRAIL_MODEL=gpt-4o-mini                    # Model for constraint evaluation (default: from LLM_MODEL)
GUARDRAIL_MAX_TOKENS=1000                      # Max tokens for evaluation response (default: 1000, range: 100-4000)
GUARDRAIL_TIMEOUT_MS=5000                      # Timeout for evaluation in ms (default: 5000, min: 1000)
GUARDRAIL_MAX_CONSTRAINTS=10                   # Max constraints per evaluation (default: 10, range: 1-50)
