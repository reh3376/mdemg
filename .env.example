# ===== Docker Deployment (auto-configured by: mdemg init) =====
# These are REQUIRED for docker compose. Run `mdemg init` to auto-assign free ports.
# All ports are dynamically scanned — no hardcoded defaults.
COMPOSE_PROJECT_NAME=mdemg
MDEMG_PORT=
NEO4J_BOLT_PORT=
NEO4J_HTTP_PORT=
TSDB_HOST_PORT=
NEURAL_PORT=
GRAFANA_PORT=

# TimescaleDB metrics (enabled by default in Docker)
TSDB_ENABLED=true

# Service credentials (auto-configured by: mdemg init)
# NEO4J_PASS=          # Neo4j password (auto-generated if not set)
# GRAFANA_PASSWORD=     # Grafana admin password (default: admin)
# TSDB_PASSWORD=        # TimescaleDB password (default: mdemg_metrics)
# TSDB_USER=            # TimescaleDB user (default: mdemg)

# MDEMG Service Configuration
# Copy this file to .env and fill in your values

# Neo4j Connection (required)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_password_here

# Schema version (required - must match applied migrations)
# Run `ls migrations/V*.cypher | wc -l` to find the current version
REQUIRED_SCHEMA_VERSION=26

# Service
LISTEN_ADDR=:9999

# Dynamic Port Allocation (optional)
# If LISTEN_ADDR port is busy, server scans this range for an available port.
# PORT_RANGE_START=9999         # Start of fallback range (default: derived from LISTEN_ADDR)
# PORT_RANGE_END=10099          # End of fallback range (default: PORT_RANGE_START + 100)
# PORT_FILE_PATH=.mdemg.port   # Port file for client discovery (default: .mdemg.port)

# Retrieval tuning
VECTOR_INDEX_NAME=memNodeEmbedding
DEFAULT_CANDIDATE_K=200
DEFAULT_TOP_K=20
DEFAULT_HOP_DEPTH=2
MAX_NEIGHBORS_PER_NODE=50
MAX_TOTAL_EDGES_FETCHED=5000
LEARNING_EDGE_CAP_PER_REQUEST=200

# Top-level LLM settings — cascade to all cognitive features
# (rerank, summary, synthesis, intent, emergence, guardrail)
# Per-feature overrides (e.g. SYNTHESIS_PROVIDER) still take precedence.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b-instruct-fp16
# For OpenAI training data collection campaign, use: LLM_MODEL=gpt-5.4-mini

# LLM Retry (exponential backoff with jitter for transient failures)
LLM_RETRY_ENABLED=true                         # Enable LLM call retry (default: true)
LLM_RETRY_MAX_ATTEMPTS=5                       # Max retry attempts (default: 5)
LLM_RETRY_BASE_DELAY_MS=500                    # Initial backoff delay in ms (default: 500)
LLM_RETRY_MAX_DELAY_MS=60000                   # Max backoff delay in ms (default: 60000 — respects Retry-After headers up to this cap)
LLM_RETRY_DEADLINE_ENABLED=true                # Retry once on context.DeadlineExceeded if remaining budget > 2× base delay (default: true, DH-004)

# Embedding Provider: "openai", "ollama", or "" (disabled)
EMBEDDING_PROVIDER=ollama

# OpenAI settings (only needed if using OpenAI for embeddings or LLM)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=text-embedding-3-large
OPENAI_ENDPOINT=https://api.openai.com/v1

# LLM_ENDPOINT — Override endpoint for all LLM text-generation calls
# (synthesis, intent translation, emergence naming, reranking).
# If unset, falls back to OPENAI_ENDPOINT.
# Use this to point LLM calls at a local MLX server while keeping
# OPENAI_ENDPOINT for embeddings.
# LLM_ENDPOINT=http://172.21.21.11:8080/v1

# Ollama settings (if EMBEDDING_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:8b
# EMBEDDING_TARGET_DIMS=3072     # Target dimensions for MRL truncation (0 = use model native; default 3072 for qwen3-embedding:8b)

# Embedding Cache (LRU caching of embedding results)
EMBEDDING_CACHE_ENABLED=true   # Enable caching (default: true)
EMBEDDING_CACHE_SIZE=1000       # Max cached embeddings (default: 1000)
EMBEDDING_CACHE_DEBUG=false     # Enable debug logging for cache hits/misses (default: false)

# Node Embedding Cache (graph expansion LRU cache)
# NODE_EMBEDDING_CACHE_SIZE=5000             # LRU cache size for node embeddings (default: 5000)
# NODE_EMBEDDING_CACHE_TTL_SEC=3600          # TTL for embedding cache entries in seconds (default: 3600, 0 = no TTL)

# Temporal Retrieval (time-aware query understanding)
TEMPORAL_ENABLED=true           # Enable temporal query detection (default: true)
TEMPORAL_SOFT_BOOST=3.0         # Recency weight multiplier for soft-mode queries (default: 3.0, range: 1.0-10.0)
TEMPORAL_HARD_FILTER=true       # Enable hard time-range filtering (default: true)

# Linear Integration (for linear-module plugin)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_TEAM_ID=                 # Default team key for issue creation (e.g., "ENG")

# ===== Ingest =====

# Speed preset for codebase ingestion: "fast", "balanced", "thorough", or "" (use individual flags)
# INGEST_SPEED=balanced

# ===== Phase 47: Optimistic Retry + Edge Consistency =====

# Optimistic Lock Retry Settings
# Enables retry with exponential backoff on version conflicts
OPTIMISTIC_RETRY_ENABLED=true           # Enable optimistic locking (default: true)
OPTIMISTIC_RETRY_MAX_ATTEMPTS=5         # Max retry attempts (default: 5)
OPTIMISTIC_RETRY_BASE_DELAY_MS=10       # Initial delay in ms (default: 10)
OPTIMISTIC_RETRY_MAX_DELAY_MS=1000      # Max delay in ms (default: 1000)
OPTIMISTIC_RETRY_MULTIPLIER=2.0         # Backoff multiplier (default: 2.0)

# Edge Staleness Cascade Settings
# Controls how edge updates cascade when node embeddings change
EDGE_STALENESS_CASCADE_ENABLED=true     # Enable staleness cascade (default: true)
EDGE_STALENESS_REFRESH_BATCH_SIZE=100   # Edges to refresh per call (default: 100)

# ===== Phase 48: Data Transmission & Connection Pooling =====

# Embedding Rate Limiting (protects against provider rate limits)
EMBEDDING_RATE_LIMIT_ENABLED=false      # Enable rate limiting (default: false)
EMBEDDING_OPENAI_RPS=500                # OpenAI requests per second (default: 500)
EMBEDDING_OPENAI_BURST=1000             # OpenAI burst allowance (default: 1000)
EMBEDDING_OLLAMA_RPS=100                # Ollama requests per second (default: 100)
EMBEDDING_OLLAMA_BURST=200              # Ollama burst allowance (default: 200)

# Memory Pressure Backpressure (protects against OOM)
MEMORY_PRESSURE_ENABLED=false           # Enable memory backpressure (default: false)
MEMORY_PRESSURE_THRESHOLD_MB=4096       # Heap threshold in MB (default: 4096)

# ===== Phase 51: Web Scraper Ingestion =====

# Web Scraper Module Settings
SCRAPER_ENABLED=false                          # Enable web scraper module (default: false)
SCRAPER_DEFAULT_SPACE_ID=web-scraper           # Default target space for scraped content (default: web-scraper)
SCRAPER_MAX_CONCURRENT_JOBS=3                  # Max concurrent scrape jobs (default: 3)
SCRAPER_DEFAULT_DELAY_MS=1000                  # Delay between requests in ms (default: 1000)
SCRAPER_DEFAULT_TIMEOUT_MS=30000               # HTTP timeout per request in ms (default: 30000)
SCRAPER_CACHE_TTL_SECONDS=3600                 # robots.txt cache TTL in seconds (default: 3600)
SCRAPER_RESPECT_ROBOTS_TXT=true                # Respect robots.txt (default: true)
SCRAPER_MAX_CONTENT_LENGTH_KB=500              # Max content length in KB (default: 500)

# ===== Phase 70: Neo4j Backup & Restore =====

# Backup Module Settings
BACKUP_ENABLED=false                           # Enable backup module (default: false)
BACKUP_STORAGE_DIR=./backups                   # Directory for backup artifacts (default: ./backups)
BACKUP_FULL_CMD=docker                         # Command for full backups (default: docker)
BACKUP_NEO4J_CONTAINER=mdemg-neo4j             # Docker container name for Neo4j (default: mdemg-neo4j)
BACKUP_FULL_INTERVAL_HOURS=168                 # Hours between full backups (default: 168 = weekly)
BACKUP_PARTIAL_INTERVAL_HOURS=24               # Hours between partial backups (default: 24 = daily)
BACKUP_RETENTION_FULL_COUNT=4                  # Keep last N full backups (default: 4)
BACKUP_RETENTION_PARTIAL_COUNT=14              # Keep last N partial backups (default: 14)
BACKUP_RETENTION_MAX_AGE_DAYS=90               # Delete backups older than N days (default: 90)
BACKUP_RETENTION_MAX_STORAGE_GB=50             # Storage quota in GB (default: 50)
BACKUP_RETENTION_RUN_AFTER_BACKUP=true         # Run retention after each backup (default: true)
TSDB_BACKUP_ENABLED=false                      # Enable TimescaleDB backup module (default: false)

# ===== Phase 101: SME Synthesis Engine =====

# LLM-powered synthesis for the /v1/memory/consult endpoint
# When enabled and llm_synthesis=true in request, produces coherent SME narrative
# grounded exclusively in graph evidence (not general LLM knowledge)
SYNTHESIS_ENABLED=false                        # Enable LLM synthesis (default: false)
SYNTHESIS_PROVIDER=openai                      # LLM provider: openai or ollama (default: from LLM_PROVIDER)
SYNTHESIS_MODEL=gpt-5.4-mini                        # Model for synthesis (default: from LLM_MODEL)
SYNTHESIS_MAX_TOKENS=2000                      # Max tokens for synthesis response (default: 2000, range: 100-8000)
SYNTHESIS_TIMEOUT_MS=30000                     # Timeout for synthesis call in ms (default: 30000, min: 1000)
SYNTHESIS_COMPRESS=true                        # Use J17 prompt compression for synthesis LLM calls (default: true)

# Intent Translation (Phase 102): LLM query rewriting before vector embedding
# When enabled and translate_intent=true in request, rewrites conversational queries
# into keyword-dense search strings optimized for vector similarity.
INTENT_ENABLED=false                           # Enable intent translation (default: false)
INTENT_PROVIDER=openai                         # LLM provider: openai or ollama (default: from LLM_PROVIDER)
INTENT_MODEL=gpt-5.4-mini                           # Model for intent translation (default: from LLM_MODEL)
INTENT_MAX_TOKENS=150                          # Max tokens for rewritten query (default: 150, range: 10-500)
INTENT_TIMEOUT_MS=2000                         # Timeout for intent translation in ms (default: 2000, min: 200)

# Dynamic Emergence (Phase 103): LLM-driven concept naming for unclassified clusters
# When enabled and enable_dynamic_emergence=true in consolidate request, dense
# CO_ACTIVATED_WITH clusters that don't match hardcoded patterns are sent to an LLM
# for automatic naming and classification.
EMERGENCE_ENABLED=false                        # Enable dynamic emergence (default: false)
EMERGENCE_PROVIDER=openai                      # LLM provider: openai or ollama (default: from LLM_PROVIDER)
EMERGENCE_MODEL=gpt-5.4-mini                        # Model for concept naming (default: from LLM_MODEL)
                                               # Ollama recommendation: llama3.2:3b (Q4_K_M) — fastest latency, top name quality
EMERGENCE_MAX_TOKENS=500                       # Max tokens for naming response (default: 500, range: 100-4000)
EMERGENCE_TIMEOUT_MS=10000                     # Timeout for naming call in ms (default: 10000, min: 1000)
EMERGENCE_MIN_WEIGHT=0.3                       # Min CO_ACTIVATED_WITH weight for clustering (default: 0.3, range: 0.0-1.0)
EMERGENCE_MIN_CLUSTER_SIZE=3                   # Min nodes per cluster (default: 3, min: 2)
EMERGENCE_MAX_CLUSTERS=10                      # Max clusters to name per run (default: 10, min: 1)

# ===== AutoResearch: LLM-Powered Intelligence (Phase AR-3) =====
# All three classifiers default provider/model from EMERGENCE_PROVIDER/EMERGENCE_MODEL.
# All are opt-in (default: false).

# R3: LLM RSIC Reflector — analyzes assessment + cycle history for pattern detection
RSIC_LLM_REFLECT_ENABLED=false                 # Enable LLM reflection alongside rule-based (default: false)
# RSIC_LLM_REFLECT_PROVIDER=openai             # Override provider (default: from EMERGENCE_PROVIDER)
# RSIC_LLM_REFLECT_MODEL=gpt-4o-mini           # Override model (default: from EMERGENCE_MODEL)
RSIC_LLM_REFLECT_COMPRESS=true                 # Use J17 prompt compression for RSIC reflection LLM calls (default: true)
RSIC_LLM_REFLECT_TIMEOUT_MS=15000              # Timeout for RSIC reflection LLM call in ms (default: 15000, min: 5000)

# RSIC-SK1: Guidance Self-Calibration
RSIC_GUIDANCE_CALIBRATION_ENABLED=true          # Master switch for guidance self-calibration (default: true)
RSIC_GUIDANCE_MIN_SURFACES=3                    # Min surfaces before effectiveness is meaningful (default: 3)
RSIC_GUIDANCE_BOOST_THRESHOLD=0.7               # Effectiveness rate above which confidence is boosted (default: 0.7)
RSIC_GUIDANCE_DECAY_THRESHOLD=0.1               # Effectiveness rate below which confidence is decayed (default: 0.1)
RSIC_GUIDANCE_DECAY_MIN_SURFACES=5              # Min surfaces before decay applies (default: 5)

# J3: LLM Constraint Classifier — replaces keyword-based constraint detection
CONSULTING_LLM_CONSTRAINTS_ENABLED=true        # Enable LLM constraint classification (recommended for training data collection)
# CONSULTING_LLM_CONSTRAINTS_PROVIDER=openai   # Override provider (default: from EMERGENCE_PROVIDER)
# CONSULTING_LLM_CONSTRAINTS_MODEL=gpt-4o-mini # Override model (default: from EMERGENCE_MODEL)
CONSULTING_CLASSIFY_TIMEOUT_MS=30000           # Timeout for consulting classify LLM call in ms (default: 30000, min: 5000 — bumped from 15000 in DH-004)


# ===== AutoResearch: Jiminy Effectiveness Tracking (Phase AR-2) =====
JIMINY_EFFECTIVENESS_TTL_SEC=86400             # TTL for tracked guidance in seconds (default: 86400 = 24h)
JIMINY_CLASSIFY_COMPRESS=true                  # Use J17 prompt compression for Jiminy outcome classification LLM calls (default: true)

# ===== Jiminy Code Comprehension Feedback Loop (P1-15) =====
# JIMINY_CODE_REGEN_ENABLED=false              # Enable code comprehension feedback loop (default: false)
# JIMINY_CODE_REGEN_THRESHOLD=0.3              # Avg comprehension below this triggers regen (default: 0.3)
# JIMINY_CODE_REGEN_MIN_SAMPLES=10             # Minimum samples before evaluating (default: 10)

# ===== ANN Optimization: Learning Subsystem =====

# Tanh Soft-Capping (replaces hard clamp at wmax for smooth saturation)
# Applied automatically — uses existing LEARNING_WMAX as the cap value.

# Cautious Decay — skip decay for edges reinforced within this window
LEARNING_CAUTIOUS_DECAY_WINDOW_HOURS=24   # Hours (default: 24, 0=disabled)

# Multi-Rate Learning — context-specific eta multipliers
LEARNING_ETA_CONVERSATION_MULT=2.0        # Multiplier for conversation observations (default: 2.0)
LEARNING_ETA_CONFIG_MULT=1.5              # Multiplier for config↔code edges (default: 1.5)
LEARNING_ETA_SAME_DIR_MULT=1.2            # Multiplier for same-directory nodes (default: 1.2)

# Learning Rate Schedule — maturity-based eta scaling
LEARNING_SCHEDULE_ENABLED=true            # Enable maturity-based LR schedule (default: true)
LEARNING_SCHEDULE_COLD_MULT=2.0           # Multiplier for cold spaces, 0 edges (default: 2.0)
LEARNING_SCHEDULE_LEARNING_MULT=1.0       # Multiplier for learning spaces, 1-10k edges (default: 1.0)
LEARNING_SCHEDULE_WARM_MULT=0.5           # Multiplier for warm spaces, 10k-50k edges (default: 0.5)
LEARNING_SCHEDULE_SAT_MULT=0.25           # Multiplier for saturated spaces, 50k+ edges (default: 0.25)

# ===== ANN Optimization: Retrieval Subsystem =====

# Reciprocal Rank Fusion — constant for RRF score combination
RRF_CONSTANT=60                               # RRF k parameter (default: 60, min: 1)

# Spreading Activation — configurable steps and decay
ACTIVATION_STEPS=2                            # Number of activation hops (default: 2, range: 1-10)
ACTIVATION_LAMBDA=0.15                        # Decay factor per hop (default: 0.15, range: 0.0-0.9)

# BM25 Scoring Weight — separate signal in final scoring formula
SCORING_BM25_WEIGHT=0.15                      # Weight for BM25 component (default: 0.15, range: 0.0-1.0)

# Squared Activation — sharper, sparser activation signals
SCORING_ACTIVATION_FLOOR=0.05             # Floor below which activation is zeroed (default: 0.05)
SCORING_ACTIVATION_SQUARED=true           # Enable squared activation (default: true)

# Local-First Activation Spreading — per-hop minimum edge weight thresholds
ACTIVATION_HOP0_MIN_WEIGHT=0.5            # Min edge weight for hop 0 (default: 0.5)
ACTIVATION_HOP1_MIN_WEIGHT=0.2            # Min edge weight for hop 1 (default: 0.2)
ACTIVATION_HOP2_MIN_WEIGHT=0.05           # Min edge weight for hop 2+ (default: 0.05)

# Value Residual Bypass — additive bonus for high-confidence vector matches
SCORING_BYPASS_THRESHOLD=0.85             # VectorSim threshold to trigger bypass (default: 0.85)
SCORING_BYPASS_WEIGHT=0.15                # Weight of bypass bonus (default: 0.15)
SCORING_BYPASS_CODE_MULT=1.3              # Bypass multiplier for code queries (default: 1.3)
SCORING_BYPASS_ARCH_MULT=0.5              # Bypass multiplier for architecture queries (default: 0.5)

# ===== ANN Optimization: Consolidation Subsystem =====

# L0 Skip Connections (GROUNDED_BY edges from L5 to L0)
L5_GROUNDING_MAX_EDGES=5                  # Max GROUNDED_BY edges per L5 node (default: 5)
L5_GROUNDING_MIN_SIM=0.4                  # Min cosine similarity for grounding edge (default: 0.4)
L5_GROUNDING_INITIAL_WEIGHT=0.5           # Initial weight for GROUNDED_BY edges (default: 0.5)
EDGE_ATTENTION_GROUNDED_BY=0.70           # Attention weight for GROUNDED_BY edges (default: 0.70)

# ===== ANN Optimization: API Subsystem =====

# Negative Feedback — weaken/contradict edges for rejected results
LEARNING_NEGATIVE_WEIGHT=0.15             # Weight reduction per negative feedback (default: 0.15)
LEARNING_NEGATIVE_MAX_PER_REQUEST=20      # Max rejected nodes per request (default: 20)

# Frontier Detection — identify L3+ nodes ready for expansion
FRONTIER_MIN_EVIDENCE=3                   # Min evidence_count for frontier candidates (default: 3)
FRONTIER_MAX_OUTGOING=2                   # Max outgoing edges for frontier candidates (default: 2)

# Jina Cross-Encoder Reranking (alternative to LLM-based reranking)
# RERANK_JINA_API_KEY=                          # Jina API key (required for jina reranker)
RERANK_JINA_MODEL=jina-reranker-v2-base-multilingual  # Model (default: jina-reranker-v2-base-multilingual)
RERANK_JINA_URL=https://api.jina.ai/v1        # Jina API endpoint (default: https://api.jina.ai/v1)
RERANK_COMPRESS=true                           # Use J17 prompt compression for reranking LLM calls (default: true)

# Cluster Summarization — LLM-powered summaries for L1-L4 hidden layer nodes
CLUSTER_SUMMARY_ENABLED=false                  # Enable cluster summarization (default: false)
# CLUSTER_SUMMARY_PROVIDER=                    # LLM provider (default: from LLM_PROVIDER)
# CLUSTER_SUMMARY_MODEL=                       # Model (default: from LLM_MODEL)
CLUSTER_SUMMARY_MAX_TOKENS=100                 # Max tokens per summary (default: 100)
CLUSTER_SUMMARY_TIMEOUT_MS=5000                # Timeout per call in ms (default: 5000)
CLUSTER_SUMMARY_BATCH_SIZE=50                  # Max nodes per consolidation run (default: 50)

# --- Phase 104: Active MCP Guardrails ---
GUARDRAIL_ENABLED=false                        # Enable guardrail validation (default: false)
GUARDRAIL_PROVIDER=openai                      # LLM provider: openai or ollama (default: from LLM_PROVIDER)
GUARDRAIL_MODEL=gpt-5.4-mini                        # Model for constraint evaluation (default: from LLM_MODEL)
GUARDRAIL_MAX_TOKENS=1000                      # Max tokens for evaluation response (default: 1000, range: 100-4000)
GUARDRAIL_TIMEOUT_MS=5000                      # Timeout for evaluation in ms (default: 5000, min: 1000)
GUARDRAIL_MAX_CONSTRAINTS=10                   # Max constraints per evaluation (default: 10, range: 1-50)
GUARDRAIL_COMPRESS=true                        # Use J17 prompt compression for guardrail evaluation LLM calls (default: true)

# --- Jiminy Guidance (Phase Jiminy) ---
JIMINY_ENABLED=true                             # Enable Jiminy inner voice guidance (default: true)
JIMINY_EVALUATE_LLM_ENABLED=true               # Enable LLM Tier 2 evaluation (recommended for training data collection)
JIMINY_TIMEOUT_MS=6000                          # Overall timeout for Guide() in ms (default: 6000)
JIMINY_MAX_ITEMS=10                             # Max guidance items returned (default: 10)
JIMINY_MIN_CONFIDENCE=0.3                       # Minimum confidence to include item (default: 0.3)
JIMINY_INCLUDE_FRONTIERS=true                   # Include frontier node suggestions (default: true)
JIMINY_FRONTIER_MIN_SIM=0.5                     # Min similarity for frontier nodes (default: 0.5)

# --- Jiminy J16: Input Context Limits ---
# Controls max chars sent to LLM for guidance/evaluation. Default 200000 (~50K tokens).
# Set to 0 for truly unlimited (if using 200K+ context models).
JIMINY_GUIDANCE_CONTEXT_MAX_CHARS=200000         # Max chars for agent context in guidance prompt (default: 200000)
JIMINY_GUIDANCE_OUTPUT_MAX_CHARS=200000           # Max chars for agent output in guidance prompt (default: 200000)
JIMINY_EVALUATE_OUTPUT_MAX_CHARS=200000           # Max chars for agent output in eval prompt (default: 200000)
JIMINY_EVALUATE_ITEM_MAX_CHARS=0                  # Max chars per constraint/correction in eval (default: 0 = unlimited)

# --- J17: AI-to-AI Communication Protocol ---
J17_ENABLED=true                                   # Enable J17 compact communication protocol (default: true)
J17_TICKET_SECRET=                                 # HMAC-SHA256 signing key for session tickets (auto-generated if empty)
J17_TICKET_TTL_HOURS=4                             # Session ticket TTL in hours (default: 4)
J17_SEQUENCE_BUFFER_SIZE=1000                      # Ring buffer size for event replay (default: 1000)
J17_REPLAY_MAX_EVENTS=50                           # Max events replayed on resume (default: 50)
J17_BOOTSTRAP_ENABLED=true                         # Enable bootstrap protocol for new sessions (default: true)
J17_METRICS_ENABLED=false                          # Enable protocol metrics collection (default: inherits J17)
J17_CODIFICATION_THRESHOLD=30                      # T2 send count before RSIC proposes codification (default: 30)
J17_COMPREHENSION_MIN_THRESHOLD=0.7                # Comprehension rate below which code is retired (default: 0.7)
J17_COMPRESSION_MIN_RATIO=2.0                      # Compression ratio below which RSIC flags regression (default: 2.0)
J17_REPLAY_FREQUENCY_MAX=5.0                       # Replays/hr above which RSIC adjusts buffer (default: 5.0)
J17_NLI_COMPREHENSION_ENABLED=false                # Use NLI model for comprehension scoring (default: false)
J17_PROTOCOL_DATA_COLLECTION=false                 # Enable JSONL protocol training data collection (default: false)
NEURAL_DATA_COLLECTION=false                       # Enable neural training data collection during retrieval (default: false)
J17_EXTENSIONS_ENABLED=false                       # Enable agent-negotiated protocol extensions (default: inherits J17)
J17_ALLOWED_EXTENSIONS=tier_preference,abbreviated_ids,batch_mode,density_boost  # Comma-separated allowed extensions
J17_ML_TIER_PREDICTION_ENABLED=false               # Enable ML-powered tier selection via neural sidecar (default: false)
J17_SIDECAR_URL=                                   # Neural sidecar URL for shadow ML predictions (default: empty = disabled)
J17_SIDECAR_TIMEOUT_MS=1000                        # Timeout for sidecar shadow calls in ms (default: 1000, min: 100 — bumped from 200 in DH-004; prior value caused ~56% NLI timeout rate)
JIMINY_CACHE_J17_BYPASS=true                       # Bypass guidance cache for J17 sessions to prevent cross-session contamination (default: true)

# --- J17-NS: Neural Sidecar Promotion (Shadow → Causal) ---
J17_SIDECAR_MODE=shadow                                # Sidecar arbitration mode: shadow, compare, canary, active (default: shadow)
J17_SIDECAR_CANARY_PERCENTAGE=100                      # Percentage of eligible requests routed to ML in canary mode (default: 100)
J17_SIDECAR_CONFIDENCE_FLOOR=0.6                       # ML confidence below this falls back to rule-based (default: 0.6)
J17_NLI_SCORE_OF_RECORD=false                          # Use NLI as comprehension score-of-record in canary/active (default: false)
J17_PRECEDENT_PROTECTED_CODES=                         # Comma-separated constraint codes that NEVER use ML tier (default: empty)
J17_PRECEDENT_LOG_ENABLED=true                         # Audit log when ML would change a protected constraint's tier (default: true)
J17_SIDECAR_CB_ENABLED=true                            # Enable circuit breaker for sidecar calls (default: true)
J17_SIDECAR_CB_FAILURE_THRESHOLD=3                     # Consecutive failures before circuit opens (default: 3)
J17_SIDECAR_CB_TIMEOUT_SEC=15                          # Seconds before half-open probe after circuit opens (default: 15)

# NLI Feedback Loop: Per-Tier Effectiveness + Calibration
J17_NLI_OBSERVATIONAL_ENABLED=true                     # NLI scores flow to metrics in all modes, not just causal (default: true)
J17_TIER_EFFECTIVENESS_MIN_SAMPLES=5                   # Min outcomes per tier/code before grading (default: 5)
J17_TIER_INEFFECTIVE_THRESHOLD=0.6                     # Comprehension below this = ineffective tier (default: 0.6)
J17_TIER_DRIFT_DETECTION_ENABLED=true                  # Enable j17_tier_ineffective RSIC pattern (default: true)
J17_NLI_CALIBRATION_WINDOW_SIZE=500                    # Ring buffer size for NLI/heuristic comparison (default: 500)
J17_NLI_CALIBRATION_BIAS_THRESHOLD=0.15                # Max acceptable NLI-vs-heuristic mean bias (default: 0.15)

# ===== Synergy: Claude Code ↔ MDEMG Token Optimization =====
SYNERGY_MEMORY_LINE_THRESHOLD=120        # Line count before overflow triggers (default: 120)
SYNERGY_MEMORY_AUTO_INGEST=true          # Master switch for auto-ingestion (default: true)
# SYNERGY_CLAUDE_MD_PATH=                # Path to CLAUDE.md (default: auto-detect from CWD)
# SYNERGY_MEMORY_MD_PATH=                # Path to MEMORY.md (default: auto-detect from ~/.claude/projects/)
SYNERGY_ASSESSMENT_ENABLED=true          # Master switch for synergy RSIC dimension (default: true)
SYNERGY_TARGET_CLAUDE_LINES=150          # Target line count for CLAUDE.md (default: 150)
SYNERGY_TARGET_MEMORY_LINES=120          # Target line count for MEMORY.md (default: 120)
SYNERGY_OVERLAP_SAMPLE_SIZE=5            # Lines sampled for overlap check (default: 5)
SYNERGY_OVERFLOW_ALERT_THRESHOLD=5       # Overflow events/24h before RSIC alert (default: 5)

# Recovery Buffer: store-and-forward during Jiminy outages
SYNERGY_RECOVERY_BUFFER_SPACE=synergy-buffer           # CMS space for buffered observations (default: synergy-buffer)
SYNERGY_RECOVERY_BUFFER_PATH=.mdemg/synergy-recovery-buffer.jsonl  # Local JSONL fallback path (default: .mdemg/synergy-recovery-buffer.jsonl)
SYNERGY_RECOVERY_BUFFER_MAX_ENTRIES=50                 # Max JSONL entries before FIFO eviction (default: 50)
SYNERGY_RECOVERY_AUTO_FLUSH=true                       # Auto-flush buffer on Jiminy recovery at session start (default: true)

# ===== Sprint FT-LORA-B guardrail task-name constant =====
# Tags llmclient interactions with the canonical ULTS task name; matches
# docs/tests/ults/specs/guardrail_evaluate.ults.json. Consumed by
# internal/guardrail (Sprint B cutover 2026-04-21).
GUARDRAIL_TASK_NAME=guardrail.evaluate

# ===== Sprint FT-LORA-E training-infra knobs (consumed by neural/training/train_ft.py) =====
# Activated in Sprint E. Every knob has a CLI override on train_ft.py; env values
# here are fallbacks. Policies (epoch cap, early-stop ratios) are enforced —
# CLI/env only widens within policy, never loosens it.
#
# **Post-Phase-5 pivot (2026-04-22)**: Dense Qwen3-14B-4bit replaces MoE
# Qwen3.6-35B-A3B after Metal 499K MTLResource architectural ceiling on
# MoE backward. Tier 2 MoE family adapters ABANDONED. Dense has no router,
# so ROUTER_AUX_LOSS_COEF and ASYMMETRIC_QUANT_* variables are no-ops
# unless an MoE revival path is adopted. Retained for env-schema stability.
ROUTER_AUX_LOSS_COEF=0.002          # MoE load-balancing auxiliary loss coefficient (0.0 for dense)
LORA_TIER1_RANK=32                  # Tier 1 LoRA rank (attention + shared expert for MoE; all 7 proj modules for dense)
LORA_TIER1_ALPHA=64                 # Tier 1 LoRA alpha
LORA_TIER2_RANK=8                   # Tier 2 LoRA rank — ABANDONED post-pivot (MoE routed experts only)
LORA_TIER2_ALPHA=16                 # Tier 2 LoRA alpha — ABANDONED post-pivot
LORA_N_EPOCHS_CAP=3                 # Max epochs per tier — auto is DISALLOWED (FT-OAI-001 forcing function)
LORA_EARLY_STOP_SFT_THRESHOLD=1.05  # val_loss > best × this → early stop (2 consecutive evals)
LORA_EARLY_STOP_RL_THRESHOLD=0.95   # val_reward < best × this → early stop (2 consecutive evals)
ASYMMETRIC_QUANT_SHARED=bf16        # Shared expert + attention quant — MoE-only; dense ignores
ASYMMETRIC_QUANT_ROUTED=mxfp4_moe   # Routed experts quant — MoE-only
ASYMMETRIC_QUANT_ATTN=bf16          # Attention quant — MoE-only (dense pre-quantized 4-bit)

# ===== Sprint FT-LORA-PHASE5 model paths (post-pivot dense baseline + merged) =====
# Added 2026-04-22 after Phase 5 SFT executed. Paths used by training and eval
# scripts; serving layer (llmclient) uses LLM_MODEL + LLM_ENDPOINT above.
#
# Baseline: dense Qwen3-14B-4bit (replaces abandoned MoE Qwen3.6-35B-A3B-mxfp4).
# Trained-against + evaluated-against base — local cache path or HF name.
MLX_BASE_MODEL=mlx-community/Qwen3-14B-4bit
MLX_BASE_MODEL_PATH=${HOME}/hf_cache/hub/models--mlx-community--Qwen3-14B-4bit/snapshots/a4d9b2df59d2c150bef02fcbe0d91046b7ca33a4
MLX_BASE_MODEL_CONFIG_SHA256=a54ec18ffe24f3c909e9556471dc156ed9b3b61b872008831c7cba9d4768b4a5
#
# Merged MDEMG fine-tuned model (Phase 5 SFT output, Iter 2400 best LoRA fused
# into base). 7.8 GB, 4-bit preserved. Gitignored (exceeds 100MB/file GitHub cap).
MLX_MERGED_MODEL=qwen3-14b-mdemg-v1
MLX_MERGED_MODEL_PATH=${PWD}/.local-models/qwen3-14b-mdemg-v1
#
# Serving on mlx_lm.server (CMS-pinned port 8101, single-instance):
#   python -m mlx_lm.server --model ${MLX_BASE_MODEL_PATH} --host 127.0.0.1 --port 8101
#   python -m mlx_lm.server --model ${MLX_MERGED_MODEL_PATH} --host 127.0.0.1 --port 8101
# Point LLM calls at this server via: LLM_ENDPOINT=http://127.0.0.1:8101/v1
# Adapter manifest: adapters/tier1/manifest.json (SHA pins + regression verdicts).
