# Private and internal content (not for public repo)
private/
experiment/
docs/internal/

# MDEMG project config (generated by mdemg init)
.mdemg/

# Environment and secrets
.env
.env.*
!.env.example

# API Keys and Secrets - NEVER COMMIT
**/secrets/
!internal/secrets/
*.key
*.pem

# Investigation working data (raw query outputs)
investigation-data/

# Training data exports (TSDB exports, filtered/converted JSONL, OpenAI/MLX outputs)
# — never committed; regenerated per run. README and .gitkeep tracked.
training_data/*
!training_data/README.md
!training_data/.gitkeep
# Sprint FT-LORA-D expert activation profiling artifacts — per-family profile
# JSONs + anchor prompt corpus ARE deliverables (consumed by Sprint E Tier 2
# training). raw_activation_counts.json is a debug dump — not committed.
!training_data/routing_profiles/
training_data/routing_profiles/*
!training_data/routing_profiles/anchor_prompts.jsonl
!training_data/routing_profiles/anchor_prompts.sha256
!training_data/routing_profiles/profile_routing_reasoning_think.json
!training_data/routing_profiles/profile_routing_classify_notink.json
!training_data/routing_profiles/profile_routing_structured_notink.json
# Sprint FT-LORA-DATA Phase 5 curated datasets — tier1 + 3 families ARE
# deliverables (consumed by Phase 5 SFT `mlx_lm.lora --data <dir>`). Manifests
# pin raw-SHA + model-SHA + per-task counts. Intermediate recurated.jsonl
# (~709 MB) is NOT committed — regeneratable from pinned raw-SHA.
!training_data/sft/
training_data/sft/*
!training_data/sft/tier1/
!training_data/sft/family_reasoning_think/
!training_data/sft/family_classify_notink/
!training_data/sft/family_structured_notink/
!training_data/sft/mdemg_usage_v1/
!training_data/sft/**/train.jsonl
!training_data/sft/**/valid.jsonl
!training_data/sft/**/manifest.json
# Sprint MDEMG-USAGE-CORPUS-CURATE-001 — additional canonical artifacts
!training_data/sft/mdemg_usage_v1/distribution_report.txt
!training_data/sft/mdemg_usage_v1/leak_audit.json
!training_data/curated/
training_data/curated/*
!training_data/curated/sft_synth_v1/
training_data/curated/sft_synth_v1/*
!training_data/curated/sft_synth_v1/consulting_synthesis.jsonl
!training_data/curated/sft_synth_v1/metalearn_generalize.jsonl
!training_data/curated/sft_synth_v1/hidden_summarize.jsonl
!training_data/curated/sft_synth_v1/rerank_nli.jsonl
!training_data/curated/sft_synth_v1/summarize_generate.jsonl

# Sprint FT-LORA-PHASE5 adapter + merged-model artifacts
# Safetensors files exceed GitHub's 100MB/file limit; SHAs + hyperparams live
# in adapters/*/manifest.json + .earlystop.json + train_report.json (tracked).
adapters/*/*.safetensors
adapters/*/*.safetensors.bak
adapters/*/train.log
adapters/*/training_log.jsonl
adapters/_archive_*
# Merged fine-tuned model produced by `mlx_lm fuse` (7.8 GB, local-only).
.local-models/

