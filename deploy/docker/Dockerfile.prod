# MDEMG Production Dockerfile
# Multi-stage build for minimal image size

# Build stage
FROM golang:1.24-alpine AS builder

# Install build dependencies (including C compiler for CGO)
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev

WORKDIR /build

# Copy go mod files first for layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build with CGO enabled for tree-sitter support
RUN CGO_ENABLED=1 go build \
    -ldflags="-s -w -X mdemg/internal/cli.Version=$(git describe --tags --always 2>/dev/null || echo 'dev') -X mdemg/internal/cli.Commit=$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown') -X mdemg/internal/cli.BuildDate=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o mdemg ./cmd/mdemg

# Runtime stage
FROM alpine:3.19

# Security: run as non-root
RUN addgroup -g 1000 mdemg && \
    adduser -u 1000 -G mdemg -s /bin/sh -D mdemg

# Install runtime dependencies (libc for CGO binaries)
RUN apk add --no-cache ca-certificates tzdata libc6-compat

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/mdemg .

# Copy any static files if needed
# COPY --from=builder /build/static ./static

# Set ownership
RUN chown -R mdemg:mdemg /app

USER mdemg

# Expose port
EXPOSE 9999

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:9999/healthz || exit 1

# Run the application
ENTRYPOINT ["./mdemg", "serve"]
