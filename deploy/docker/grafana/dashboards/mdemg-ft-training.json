          "format": "time_series"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "Entropy Health",
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          },
          "noValue": "Not yet collected"
        }
      }
    }
  ],
