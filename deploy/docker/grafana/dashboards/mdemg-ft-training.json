  "panels": [
    {
      "title": "Status Notice",
      "type": "text",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"padding:8px 12px;font-size:14px;color:#FF9830\"><strong>Fine-tuning pipeline metrics will auto-populate when FT data collection begins.</strong> Panels query llm_interactions, ft_benchmarks, ft_training_cycles, and ft_model_versions tables.</div>"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 1,
      "title": "Fine-Tuning Pipeline",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "LLM Interaction Collection Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time,\n  COUNT(*) / EXTRACT(EPOCH FROM '$__interval'::interval) AS rate\nFROM llm_interactions\nWHERE space_id = '$space_id'\n  AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Interactions/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "Not yet collected"
        }
      }
    },
    {
      "id": 3,
      "title": "Model Version Timeline",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT deployed_at AS time, version AS metric, overall_score AS value\nFROM ft_model_versions\nWHERE status IN ('active', 'retired')\n  AND $__timeFilter(deployed_at)\nORDER BY deployed_at",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "Not yet collected"
        }
      }
    },
    {
      "id": 4,
      "title": "Benchmark Scores",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time, task_name AS metric, weighted_score AS value\nFROM ft_benchmarks\nWHERE $__timeFilter(time)\nORDER BY time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "Not yet collected"
        }
      }
    },
    {
      "id": 5,
      "title": "Training Cycle History",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time, cycle_id, model_version, status, stage,\n  exogenous_ratio, duration_secs, error\nFROM ft_training_cycles\nWHERE $__timeFilter(time)\nORDER BY time DESC\nLIMIT 50",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not yet collected"
        }
      }
    },
    {
      "id": 6,
      "title": "Exogenous Ratio",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time, exogenous_ratio AS value\nFROM ft_training_cycles\nWHERE status = 'completed'\n  AND $__timeFilter(time)\nORDER BY time DESC\nLIMIT 1",
          "format": "time_series"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "Exogenous Ratio",
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          },
          "noValue": "Not yet collected"
        }
      }
    },
    {
      "id": 7,
      "title": "Entropy Health",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time,\n  AVG(quality) AS value\nFROM llm_interactions\nWHERE quality IS NOT NULL\n  AND space_id = '$space_id'\n  AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "Entropy Health",
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          },
          "noValue": "Not yet collected"
        }
      }
    }
  ],
