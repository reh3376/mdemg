    {
      "title": "Concept Details",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "collapsed": false
    },
    {
      "title": "Recent Concept Emergence",
      "description": "Concepts created in the last 24 hours within selected layers, ordered by creation time.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "kniepdennis-neo4j-datasource",
        "uid": "neo4j"
      },
      "targets": [
        {
          "refId": "A",
          "cypherQuery": "MATCH (n:MemoryNode {space_id: '$space_id'}) WHERE n.layer IN [${layers:raw}] AND n.created_at IS NOT NULL AND n.created_at >= datetime() - duration('P1D') RETURN COALESCE(n.name, n.summary, 'unnamed') AS Name, n.layer AS Layer, n.created_at AS Created, size([(n)-[]-() | 1]) AS Edges ORDER BY n.created_at DESC LIMIT 20",
          "Format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Layer"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 2
                    },
                    {
                      "color": "yellow",
                      "value": 3
                    },
                    {
                      "color": "orange",
                      "value": 4
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background-solid"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Edges"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Top Activated Concepts",
      "description": "Concepts within selected layers ranked by activation score. High activation indicates recently and frequently accessed knowledge.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "kniepdennis-neo4j-datasource",
        "uid": "neo4j"
      },
      "targets": [
        {
          "refId": "A",
          "cypherQuery": "MATCH (n:MemoryNode {space_id: '$space_id'}) WHERE n.layer IN [${layers:raw}] RETURN COALESCE(n.name, n.summary, 'unnamed') AS Name, n.layer AS Layer, round(COALESCE(n.activation, 0.0) * 1000) / 1000 AS Activation, n.last_activated AS `Last Active`, size([(n)-[]-() | 1]) AS Edges ORDER BY n.activation DESC LIMIT 20",
          "Format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Layer"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 2
                    },
                    {
                      "color": "yellow",
                      "value": 3
                    },
                    {
                      "color": "orange",
                      "value": 4
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
