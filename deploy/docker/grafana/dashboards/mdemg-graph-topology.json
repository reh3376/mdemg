        {
          "title": "How to Explore",
          "type": "text",
          "gridPos": {
            "h": 2,
            "w": 24,
            "x": 0,
            "y": 30
          },
          "options": {
            "mode": "html",
            "content": "<div style=\"padding:8px 12px;font-size:13px;color:#aaa\"><strong>Neighborhood Explorer</strong> \u2014 Select one or more <em>Focus Node(s)</em> from the variable bar above to explore their connections. Use <em>Edge Types</em> to filter relationship categories and <em>Hop Depth</em> to control traversal distance (1-3 hops). The graph shows all reachable nodes with force-directed layout.</div>"
          },
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          }
        },
        {
          "title": "Neighborhood Explorer",
          "description": "Multi-hop neighborhood around the selected Focus Node(s). Shows reachable nodes within the configured Hop Depth, filtered by Edge Types, with force-directed layout.",
