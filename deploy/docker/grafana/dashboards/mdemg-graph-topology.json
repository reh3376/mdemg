          "datasource": {
            "type": "hamedkarbasi93-nodegraphapi-datasource",
            "uid": "mdemg-nodegraph"
          },
          "targets": [
            {
              "refId": "A",
              "queryText": "type=neighborhood&space_id=${space_id}&node_id=${focus_nodes:csv}&edge_types=${edge_types:csv}&hop_depth=${hop_depth}&page_size=${page_size}"
            }
          ],
          "transformations": [],
          "options": {
