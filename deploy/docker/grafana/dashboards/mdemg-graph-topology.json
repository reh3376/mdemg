              "options": "Activation"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0.3
                    },
                    {
                      "color": "yellow",
                      "value": 0.6
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background-solid"
              }
            ]
          },
          {
            "matcher": {
