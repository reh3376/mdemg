      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;gap:32px;flex-wrap:wrap;padding:4px 8px;font-size:12px;line-height:1.8\">\n  <div><strong>Node Layers:</strong>\n    <span style=\"color:#5794F2\">\u25cf</span> L0/L1 Raw/Obs &nbsp;\n    <span style=\"color:#73BF69\">\u25cf</span> L2 Concepts &nbsp;\n    <span style=\"color:#FADE2A\">\u25cf</span> L3 Abstractions &nbsp;\n    <span style=\"color:#FF9830\">\u25cf</span> L4 Meta &nbsp;\n    <span style=\"color:#F2495C\">\u25cf</span> L5 Paradigms\n  </div>\n  <div><strong>Edge Types:</strong>\n    <span style=\"color:#B877D9\">\u2014</span> Structural &nbsp;\n    <span style=\"color:#8AB8FF\">\u2014</span> Learned &nbsp;\n    <span style=\"color:#FF9830\">\u2014</span> Causal &nbsp;\n    <span style=\"color:#FF6EB4\">\u2014</span> Cross-domain &nbsp;\n    <span style=\"color:#8F8F8F\">\u2014</span> Association &nbsp;\n    <span style=\"color:#73BF69\">\u2014</span> Code &nbsp;\n    <span style=\"color:#FADE2A\">\u2014</span> Compositional &nbsp;\n    <span style=\"color:#6ED0E0\">\u2014</span> Provenance &nbsp;\n    <span style=\"color:#F2495C\">\u2014</span> Contrast\n  </div>\n  <div><em>Scroll to zoom \u2022 Drag to pan \u2022 Click node for details</em></div>\n</div>"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "",
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"padding:6px 12px;font-size:13px;color:#aaa;display:flex;justify-content:space-between\"><span>Viewing page <strong style=\"color:#fff\">${page}</strong> &mdash; <strong style=\"color:#fff\">${page_size}</strong> nodes per page. Use the <em>Page</em> field above to navigate.</span><span style=\"color:#73BF69\">Sorted by connectivity (most edges first)</span></div>"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
