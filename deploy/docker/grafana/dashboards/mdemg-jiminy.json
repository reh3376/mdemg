    },
    {
      "title": "Effectiveness Trends",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdemg_jiminy_follow_rate{space_id=\"$space_id\"}",
          "legendFormat": "Follow Rate",
          "refId": "A"
        },
        {
          "expr": "mdemg_jiminy_constraint_effectiveness{space_id=\"$space_id\"}",
          "legendFormat": "Constraint Effectiveness",
          "refId": "B"
        },
        {
          "expr": "mdemg_jiminy_source_diversity{space_id=\"$space_id\"}",
          "legendFormat": "Source Diversity",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
