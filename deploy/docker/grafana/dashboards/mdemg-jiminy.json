          "cypherQuery": "MATCH (c:MemoryNode {space_id: '$space_id', role_type: 'constraint'}) OPTIONAL MATCH (c)-[r:GUIDANCE_OUTCOME]-() WITH c.content AS Constraint, count(r) AS Surfaced, count(CASE WHEN r.outcome_type = 'followed' THEN 1 END) AS Followed, count(CASE WHEN r.outcome_type = 'partial_compliance' THEN 1 END) AS Partial, count(CASE WHEN r.outcome_type = 'ignored' THEN 1 END) AS Ignored, count(CASE WHEN r.outcome_type = 'contradicted' THEN 1 END) AS Contradicted WHERE Surfaced > 0 RETURN Constraint, Surfaced, Followed, Partial, Ignored, Contradicted, round((toFloat(Followed) + 0.5 * toFloat(Partial)) / Surfaced * 100) / 100 AS EffRate ORDER BY Surfaced DESC LIMIT 20",
          "Format": "table"
        }
