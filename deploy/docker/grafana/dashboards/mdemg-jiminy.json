      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT NOW() AS time, CASE WHEN count(*) > 1 THEN EXTRACT(EPOCH FROM (max(time) - min(time))) / (count(*) - 1) / 60.0 ELSE 0 END AS value FROM metric_samples WHERE metric_name = 'mdemg_compact_event_ts' AND metric_type = 'gauge' AND space_id = '$space_id' AND $__timeFilter(time)",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
