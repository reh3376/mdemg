        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(mdemg_jiminy_guidance_total, space_id)",
        "query": { "query": "label_values(mdemg_jiminy_guidance_total, space_id)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
