    {
      "title": "Constraint Eff. (Selected Range)",
      "description": "Dynamically computed from constraint_outcomes within the dashboard time range. Volume-weighted across constraints with 5+ outcomes in the selected interval. RE-BASELINE (JIMINY-OUTCOME-002): history before 2026-06-11T19:00Z is heuristic-dominated \u2014 94.9% of Tier-2 classifier calls were context-cancelled and fell back to half-credit partial_compliance verdicts (fixed by SUPERVISOR-002). Not comparable to post-fix LLM-classified data. Rows now carry classifier_source (tier1|llm|heuristic|explicit) to filter the artifact class.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 11,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH per_constraint AS ( SELECT constraint_id, COUNT(*) AS surfaced, SUM(CASE WHEN outcome_type = 'followed' THEN 1.0 ELSE 0.0 END) AS followed, SUM(CASE WHEN outcome_type = 'partial_compliance' THEN 0.5 ELSE 0.0 END) AS partial_half FROM constraint_outcomes WHERE space_id = '$space_id' AND $__timeFilter(time) GROUP BY constraint_id HAVING COUNT(*) >= 2 ) SELECT now() AS time, CASE WHEN SUM(surfaced) > 0 THEN (SUM(followed) + SUM(partial_half)) / SUM(surfaced)::float ELSE NULL END AS value FROM per_constraint",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No Data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        }
      }
    },
    {
      "title": "Should-Follow Follow Rate",
      "description": "JIMINY-RELEVANCE-001: follow rate on guidance that SHOULD have been followed — restricted to the ACTIONABLE guidance types (constraint/correction), excluding correctly-ignored advisory abstractions (pattern/learning/concept). This is what the >90% operator goal actually means (the naive follow rate counts correctly-ignored advisory as failures). Computed from guidance_training_rows within the dashboard time range (followed=1.0, partial_compliance=0.5). Certified-gold grounding via HITL-REVIEW-001 review_grades is a documented follow-up. Green ≥0.9 = the goal; red <0.5 = the alert floor.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT now() AS time, AVG(CASE outcome_type WHEN 'followed' THEN 1.0 WHEN 'partial_compliance' THEN 0.5 ELSE 0.0 END) AS value FROM guidance_training_rows WHERE space_id = '$space_id' AND $__timeFilter(time) AND guidance_type IN ('constraint', 'correction')",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No Data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      }
    },
