        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "title": "Outcome Trends",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdemg_jiminy_followed_total{space_id=\"$space_id\"}",
          "legendFormat": "Followed",
          "refId": "A"
        },
        {
          "expr": "mdemg_jiminy_ignored_total{space_id=\"$space_id\"}",
          "legendFormat": "Ignored",
          "refId": "B"
        },
        {
          "expr": "mdemg_jiminy_contradicted_total{space_id=\"$space_id\"}",
          "legendFormat": "Contradicted",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Followed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Ignored" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Contradicted" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      }
    },
    {
      "title": "Constraint Effectiveness",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "panels": []
    },
    {
      "title": "Per-Constraint Effectiveness",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "kniepdennis-neo4j-datasource", "uid": "neo4j" },
      "targets": [
        {
          "refId": "A",
          "cypherQuery": "MATCH (c:MemoryNode {space_id: '$space_id', node_type: 'constraint'}) OPTIONAL MATCH (c)-[r:GUIDANCE_OUTCOME]-() WITH c.content AS Constraint, count(r) AS Surfaced, count(CASE WHEN r.outcome_type = 'followed' THEN 1 END) AS Followed, count(CASE WHEN r.outcome_type = 'ignored' THEN 1 END) AS Ignored, count(CASE WHEN r.outcome_type = 'contradicted' THEN 1 END) AS Contradicted WHERE Surfaced > 0 RETURN Constraint, Surfaced, Followed, Ignored, Contradicted, round(toFloat(Followed) / Surfaced * 100) / 100 AS EffRate ORDER BY Surfaced DESC LIMIT 20",
          "Format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["mdemg", "jiminy"],
  "refresh": "30s",
  "templating": {
