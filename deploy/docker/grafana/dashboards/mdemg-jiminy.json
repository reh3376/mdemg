    {
      "title": "Per-Constraint Effectiveness",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "kniepdennis-neo4j-datasource",
        "uid": "neo4j"
      },
      "targets": [
        {
          "refId": "A",
          "cypherQuery": "MATCH (c:MemoryNode {space_id: '$space_id', role_type: 'constraint'}) OPTIONAL MATCH (c)-[r:GUIDANCE_OUTCOME]-() WITH c.content AS Constraint, count(r) AS Surfaced, count(CASE WHEN r.outcome_type = 'followed' THEN 1 END) AS Followed, count(CASE WHEN r.outcome_type = 'ignored' THEN 1 END) AS Ignored, count(CASE WHEN r.outcome_type = 'contradicted' THEN 1 END) AS Contradicted WHERE Surfaced > 0 RETURN Constraint, Surfaced, Followed, Ignored, Contradicted, round(toFloat(Followed) / Surfaced * 100) / 100 AS EffRate ORDER BY Surfaced DESC LIMIT 20",
          "Format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      }
    },
