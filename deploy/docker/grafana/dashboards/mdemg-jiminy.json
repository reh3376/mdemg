      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdemg_jiminy_followed_total{space_id=\"$space_id\"}",
          "legendFormat": "Followed",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "mdemg_jiminy_ignored_total{space_id=\"$space_id\"}",
          "legendFormat": "Ignored",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "mdemg_jiminy_contradicted_total{space_id=\"$space_id\"}",
          "legendFormat": "Contradicted",
          "instant": true,
          "refId": "C"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Followed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Ignored" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Contradicted" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      }
    },
    {
      "title": "Effectiveness Trends",
      "type": "row",
      "collapsed": false,
