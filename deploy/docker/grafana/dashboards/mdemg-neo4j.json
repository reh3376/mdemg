    {
      "title": "Space Overview",
      "description": "Per-space graph stats: nodes, edges, observations, orphans, learning edges, health score",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "cypherQuery": "MATCH (n:MemoryNode)\nWITH n.space_id AS space_id, count(n) AS nodes\nOPTIONAL MATCH (n2:MemoryNode {space_id: space_id})-[r]-()\nWITH space_id, nodes, count(DISTINCT r) AS edges\nOPTIONAL MATCH (orphan:MemoryNode {space_id: space_id})\nWHERE NOT (orphan)-[]-()\nWITH space_id, nodes, edges, count(orphan) AS orphans\nRETURN space_id AS Space,\n       nodes AS Nodes,\n       edges AS Edges,\n       orphans AS Orphans,\n       CASE WHEN nodes > 0 THEN round(toFloat(orphans) / nodes * 100) ELSE 0 END AS `Orphan %`\nORDER BY nodes DESC",
          "Format": "table"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "space_id"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "kniepdennis-neo4j-datasource",
        "uid": "neo4j"
      }
    },
