      "title": "Request Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, SUM(value) / EXTRACT(EPOCH FROM '$__interval'::interval) AS rate FROM metric_samples WHERE metric_name = 'mdemg_http_requests_total' AND metric_type = 'counter' AND space_id = '$space_id' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        }
      }
    },
