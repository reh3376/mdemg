      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT time, value FROM metric_samples WHERE metric_name = 'mdemg_http_request_duration_seconds_p95' AND metric_type = 'gauge' AND space_id = '$space_id' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, COALESCE(SUM(CASE WHEN metric_name = 'mdemg_http_requests_total' AND labels->>'status' LIKE '5__' THEN value ELSE 0 END) / NULLIF(SUM(CASE WHEN metric_name = 'mdemg_http_requests_total' THEN value ELSE 0 END), 0) * 100, 0) AS value FROM metric_samples WHERE metric_name IN ('mdemg_http_requests_total', 'mdemg_http_requests_total') AND metric_type = 'counter' AND space_id = '$space_id' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
