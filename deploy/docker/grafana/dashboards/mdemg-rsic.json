    {
      "title": "Cycle Rate (5m)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, (SUM(value) / EXTRACT(EPOCH FROM '$__interval'::interval)) * 60 AS rate FROM metric_samples WHERE metric_name = 'mdemg_rsic_cycle_total' AND metric_type = 'counter' AND labels->>'outcome' = 'started' AND space_id = '$space_id' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "title": "Cycle Success Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, COALESCE(SUM(CASE WHEN 1=1 AND labels->>'outcome' = 'completed' THEN value ELSE 0 END) / NULLIF(SUM(CASE WHEN 1=1 AND labels->>'outcome' IN ('completed', 'error', 'low_confidence') THEN value ELSE 0 END), 0) * 100, 0) AS value FROM metric_samples WHERE metric_name = 'mdemg_rsic_cycle_total' AND metric_type = 'counter' AND space_id = '$space_id' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        }
      }
    },
