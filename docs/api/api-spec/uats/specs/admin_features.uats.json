{
  "uats_version": "1.0.0",
  "api": {
    "name": "Admin Features",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "admin",
      "features",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-30",
    "description": "Validates GET /v1/admin/features returns service feature list with name, status, state, and controllable fields.",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "admin"
    ],
    "sha256": "0cb3866feeacb62d8e47cbaa2a4b0556e75d6e0bc2228836b360a2020d062fdc"
  },
  "request": {
    "method": "GET",
    "path": "/v1/admin/features"
  },
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body_assertions": [
      {
        "path": "$.features",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.features[0].name",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.features[0].status",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.features[0].state",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.features[0].controllable",
        "op": "type_is",
        "expected": "boolean"
      },
      {
        "path": "$.features[0].status",
        "op": "one_of",
        "expected": [
          "healthy",
          "stopped",
          "unavailable"
        ]
      }
    ]
  },
  "variants": [
    {
      "name": "post_method_not_allowed",
      "description": "POST /v1/admin/features returns 405",
      "request": {
        "method": "POST",
        "path": "/v1/admin/features",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      },
      "expected": {
        "status": 405,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    }
  ]
}
