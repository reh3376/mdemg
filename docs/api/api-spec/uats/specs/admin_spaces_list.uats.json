{
  "uats_version": "1.0.0",
  "api": {
    "name": "Admin Spaces List",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "admin",
      "spaces",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-02-19",
    "description": "Validates GET /v1/admin/spaces returns space listing with prunable status and counts.",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "admin"
    ],
    "sha256": "1dcaba49be161769e447221dc6889b63ca3175da420f619864570f7f69dd6586"
  },
  "request": {
    "method": "GET",
    "path": "/v1/admin/spaces"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.spaces",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.total",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.prunable_count",
        "op": "type_is",
        "expected": "integer"
      }
    ]
  },
  "variants": [
    {
      "name": "filter_prunable",
      "description": "Filter to non-prunable spaces only",
      "request": {
        "method": "GET",
        "path": "/v1/admin/spaces",
        "query": {
          "prunable": "false"
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "path": "$.spaces",
            "op": "type_is",
            "expected": "array"
          },
          {
            "path": "$.total",
            "op": "type_is",
            "expected": "integer"
          }
        ]
      }
    }
  ]
}
