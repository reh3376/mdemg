{
  "uats_version": "1.0.0",
  "api": {
    "name": "Batch Freshness",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "freshness",
      "read",
      "phase-9.2"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-02-06",
    "description": "Validates Batch Freshness endpoint for querying multiple spaces",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 30000,
    "sha256": "ec46d35fe5c01bbc7081e75be073bacf53d35b27c58e912aac5b4bc6f18c8126"
  },
  "variables": {
    "test_space_1": "demo",
    "test_space_2": "test"
  },
  "request": {
    "method": "GET",
    "path": "/v1/memory/freshness",
    "query": {
      "space_ids": "{{test_space_1}},{{test_space_2}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.spaces",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.threshold_hours",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.spaces[0].space_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.spaces[0].is_stale",
        "op": "type_is",
        "expected": "boolean"
      },
      {
        "path": "$.spaces[0].threshold_hours",
        "op": "type_is",
        "expected": "number"
      }
    ]
  },
  "error_cases": [
    {
      "name": "missing_space_ids",
      "request": {
        "method": "GET",
        "path": "/v1/memory/freshness"
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "type": "string",
            "contains": "space_ids"
          }
        ]
      }
    },
    {
      "name": "too_many_spaces",
      "request": {
        "method": "GET",
        "path": "/v1/memory/freshness",
        "query": {
          "space_ids": "s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,s12,s13,s14,s15,s16,s17,s18,s19,s20,s21,s22,s23,s24,s25,s26,s27,s28,s29,s30,s31,s32,s33,s34,s35,s36,s37,s38,s39,s40,s41,s42,s43,s44,s45,s46,s47,s48,s49,s50,s51,s52,s53,s54,s55,s56,s57,s58,s59,s60,s61,s62,s63,s64,s65,s66,s67,s68,s69,s70,s71,s72,s73,s74,s75,s76,s77,s78,s79,s80,s81,s82,s83,s84,s85,s86,s87,s88,s89,s90,s91,s92,s93,s94,s95,s96,s97,s98,s99,s100,s101"
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "type": "string",
            "contains": "maximum"
          }
        ]
      }
    }
  ]
}
