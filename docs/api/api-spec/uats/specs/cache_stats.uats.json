{
  "uats_version": "1.0.0",
  "api": {
    "name": "Cache Stats",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "cache",
      "stats",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Cache Stats endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "a9f38665d1c7df4a478e3d924d2d2369f7de8a876e4b7b3a2632b1097062c406"
  },
  "variables": {
    "test_space": "demo"
  },
  "request": {
    "method": "GET",
    "path": "/v1/memory/cache/stats"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "enabled field exists",
        "path": "$.enabled",
        "op": "exists"
      },
      {
        "name": "size is a number",
        "path": "$.size",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "capacity is a number",
        "path": "$.capacity",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "capacity is positive",
        "path": "$.capacity",
        "op": "greater_than",
        "expected": 0
      },
      {
        "name": "hits is a number",
        "path": "$.hits",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "misses is a number",
        "path": "$.misses",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "hit_rate is a number",
        "path": "$.hit_rate",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "hit_rate is not negative",
        "path": "$.hit_rate",
        "op": "greater_than_or_equal",
        "expected": 0
      },
      {
        "name": "ttl_sec is a number",
        "path": "$.ttl_sec",
        "op": "type_is",
        "expected": "number"
      }
    ]
  }
}
