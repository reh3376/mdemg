{
  "uats_version": "1.0.0",
  "api": {
    "name": "Capability Gap Metrics",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "system",
      "capability-gaps",
      "metrics",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Validates GET /v1/system/capability-gaps/metrics returns gap detection metrics",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "ab76c6eac556053b585bc6a4eec2ef8c4726b6ef6e1bf8b30b0a604cc1117918"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/system/capability-gaps/metrics"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "total_queries is a number",
        "path": "$.total_queries",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "low_score_queries is a number",
        "path": "$.low_score_queries",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "tracked_patterns is a number",
        "path": "$.tracked_patterns",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "tracked_sources is a number",
        "path": "$.tracked_sources",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "history_size is a number",
        "path": "$.history_size",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "low_score_threshold is a number",
        "path": "$.low_score_threshold",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "low_score_threshold is not negative",
        "path": "$.low_score_threshold",
        "op": "greater_than_or_equal",
        "expected": 0
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/system/capability-gaps/metrics",
        "body": {}
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
