{
  "uats_version": "1.0.0",
  "api": {
    "name": "Process Org Review Decision",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "org-review",
      "write",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Org Review Decision endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "a62a027e4623902ea815a8e131bdd703b49b7720f6171bc522d906ef21c655ab"
  },
  "variables": {
    "test_space": "uats-orgreview-test",
    "test_obs_id": "uats-obs-to-review"
  },
  "request": {
    "method": "POST",
    "path": "/v1/conversation/org-reviews/{{test_obs_id}}/decision",
    "body": {
      "space_id": "{{test_space}}",
      "decision": "approve",
      "visibility": "team",
      "notes": "Approved by UATS test"
    },
    "headers": {
      "Content-Type": "application/json",
      "X-User-ID": "uats-test-reviewer"
    }
  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "name": "obs_id present when decided",
        "path": "$.obs_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "decision is approve or reject when present",
        "path": "$.decision",
        "op": "one_of",
        "expected": [
          "approve",
          "reject"
        ],
        "optional": true
      },
      {
        "name": "reviewed_at present when decided",
        "path": "$.reviewed_at",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when present",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
