{
  "uats_version": "1.0.0",
  "api": {
    "name": "Flag Observation for Org Review",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "org-review",
      "write",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Flag for Org Review endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "db102c8046c9148ef6d151d4cc0a1906d836eb67f5206e6e8302a38f04d14326"
  },
  "variables": {
    "test_space": "uats-orgreview-test",
    "test_obs_id": "uats-obs-to-flag"
  },
  "request": {
    "method": "POST",
    "path": "/v1/conversation/observations/{{test_obs_id}}/flag-org",
    "body": {
      "space_id": "{{test_space}}",
      "reason": "Valuable insight for team reference",
      "suggested_visibility": "team"
    },
    "headers": {
      "Content-Type": "application/json",
      "X-Agent-ID": "uats-test-agent"
    }
  },
  "expected": {
    "status": [
      201,
      404
    ],
    "body_assertions": [
      {
        "name": "obs_id present when flagged",
        "path": "$.obs_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "flagged_for_review is boolean when present",
        "path": "$.flagged_for_review",
        "op": "type_is",
        "expected": "boolean",
        "optional": true
      },
      {
        "name": "review_status present when flagged",
        "path": "$.review_status",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when present",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
