{
  "uats_version": "1.0.0",
  "api": {
    "name": "Delete Snapshot",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "snapshot",
      "write",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Delete Snapshot endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "cae962085afef793e5a39213271d3e511a2a087b205928ecec28c4ef738fbef7"
  },
  "variables": {
    "test_snapshot_id": "uats-snapshot-delete-id"
  },
  "request": {
    "method": "DELETE",
    "path": "/v1/conversation/snapshot/{{test_snapshot_id}}",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      204,
      404
    ],
    "body_assertions": [
      {
        "name": "error field present on not found",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
