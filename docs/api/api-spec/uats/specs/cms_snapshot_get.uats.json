{
  "uats_version": "1.0.0",
  "api": {
    "name": "Get Snapshot by ID",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "snapshot",
      "read",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Get Snapshot by ID endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "df701f2f52d0f139ae62720bc3cc5c813b550c4c697896939d20da363bed1d29"
  },
  "variables": {
    "test_snapshot_id": "uats-snapshot-test-id"
  },
  "request": {
    "method": "GET",
    "path": "/v1/conversation/snapshot/{{test_snapshot_id}}",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "name": "snapshot_id present when found",
        "path": "$.snapshot_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "space_id present when found",
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "trigger present when found",
        "path": "$.trigger",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field present on failure",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
