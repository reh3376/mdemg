{
  "uats_version": "1.0.0",
  "api": {
    "name": "Get Latest Snapshot",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "snapshot",
      "read",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Get Latest Snapshot endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "7380a977177f50f34de6f426c1087e6116a35ab9cf5e0787159313074eb419f4"
  },
  "variables": {
    "test_space": "uats-snapshot-test"
  },
  "request": {
    "method": "GET",
    "path": "/v1/conversation/snapshot/latest",
    "query": {
      "space_id": "{{test_space}}"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "name": "snapshot_id present when found",
        "path": "$.snapshot_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "space_id present when found",
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "session_id present when found",
        "path": "$.session_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "created_at present when found",
        "path": "$.created_at",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field present on not found",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
