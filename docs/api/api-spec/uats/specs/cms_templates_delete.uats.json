{
  "uats_version": "1.0.0",
  "api": {
    "name": "Delete CMS Template",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "templates",
      "write",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Delete Template endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "3b99694e3c6dd47f3749d4c0904f69968d3cca5607002a8073ed17b860afd1a8"
  },
  "variables": {
    "test_space": "uats-templates-test",
    "test_template_id": "uats-delete-test"
  },
  "request": {
    "method": "DELETE",
    "path": "/v1/conversation/templates/{{test_template_id}}",
    "query": {
      "space_id": "{{test_space}}"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      204,
      404
    ],
    "body_assertions": [
      {
        "name": "error field type when present",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
