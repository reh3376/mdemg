{
  "uats_version": "1.0.0",
  "api": {
    "name": "Get CMS Template by ID",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "templates",
      "read",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Get Template by ID endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "922f96ddfae16d95fa4677de21424b2c42c0d5715215a29e8e2eb066ddb0d925"
  },
  "variables": {
    "test_space": "uats-templates-test",
    "test_template_id": "task_handoff"
  },
  "request": {
    "method": "GET",
    "path": "/v1/conversation/templates/{{test_template_id}}",
    "query": {
      "space_id": "{{test_space}}"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "name": "template_id present when found",
        "path": "$.template_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "space_id present when found",
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "name present when found",
        "path": "$.name",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "obs_type present when found",
        "path": "$.obs_type",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when present",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
