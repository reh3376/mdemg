{
  "uats_version": "1.0.0",
  "api": {
    "name": "Update CMS Template",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "templates",
      "write",
      "phase60"
    ]
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-07",
    "description": "Validates Update Template endpoint for CMS Phase 60",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "452ad90d37f06db30657f0d35d225105ee471772e3c9b9bfacce612a746aaab6"
  },
  "variables": {
    "test_space": "uats-templates-test",
    "test_template_id": "uats-update-test"
  },
  "request": {
    "method": "PUT",
    "path": "/v1/conversation/templates/{{test_template_id}}",
    "body": {
      "space_id": "{{test_space}}",
      "name": "Updated Template Name",
      "description": "Updated by UATS",
      "obs_type": "learning",
      "schema": {
        "type": "object",
        "properties": {
          "updated_field": {
            "type": "string"
          }
        }
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "name": "template_id present when updated",
        "path": "$.template_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "name present when updated",
        "path": "$.name",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "updated_at present when updated",
        "path": "$.updated_at",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when present",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
