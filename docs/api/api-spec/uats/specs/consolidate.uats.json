{
  "uats_version": "1.0.0",
  "api": {
    "name": "Consolidate Memory",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "consolidate",
      "write"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Consolidate Memory endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "cd29665808aeb1ab2b1a5e57d9bc4df64e6978e71ec577919e0a29c3a8c668fd"
  },
  "variables": {
    "test_space": "demo"
  },
  "request": {
    "method": "POST",
    "path": "/v1/memory/consolidate",
    "body": {
      "space_id": "{{test_space}}"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.data.space_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.data.hidden_nodes_created",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.data.hidden_nodes_updated",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.data.duration_ms",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.data.enabled",
        "op": "type_is",
        "expected": "boolean"
      }
    ]
  }
}
