{
  "uats_version": "1.0.0",
  "api": {
    "name": "Constraint Conflict Detection",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "constraints",
      "conflicts"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Trigger pairwise constraint conflict detection (FSD-2026-001 GAP-04).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "constraints",
      "conflicts",
      "fsd"
    ],
    "sha256": "462e4e2e2e540e3ccd5c5ce7decd95e2c6288e97f00d366ee2c694acce8fb0ad"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/constraints/detect-conflicts",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "test-space"
    }
  },
  "expected": {
    "status": [
      200,
      503
    ],
    "body_assertions": [
      {
        "name": "new_conflicts count when successful",
        "path": "$.new_conflicts",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "new_conflicts is not negative",
        "path": "$.new_conflicts",
        "op": "greater_than_or_equal",
        "expected": 0,
        "optional": true
      },
      {
        "name": "error field type when service unavailable",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "POST without space_id returns 400 or 503 if feature disabled",
      "request": {
        "body": {}
      },
      "expected": {
        "status": [
          400,
          503
        ]
      }
    }
  ]
}
