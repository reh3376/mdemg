{
  "uats_version": "1.0.0",
  "api": {
    "name": "Constraint Conflicts List",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": ["constraints", "conflicts"]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "List unresolved constraint conflicts (FSD-2026-001 GAP-04).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": ["constraints", "conflicts", "fsd"]
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/constraints/conflicts",
    "headers": {
      "Content-Type": "application/json"
    },
    "query_params": {
      "space_id": "test-space"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "conflicts": [],
      "total": 0
    }
  },
  "assertions": [
    {
      "type": "status",
      "expected": 200
    },
    {
      "type": "json_path",
      "path": "$.conflicts",
      "op": "exists"
    },
    {
      "type": "json_path",
      "path": "$.total",
      "op": "gte",
      "expected": 0
    }
  ],
  "variants": [
    {
      "name": "missing_space_id",
      "description": "GET without space_id returns 400",
      "request": {
        "method": "GET",
        "path": "/v1/constraints/conflicts"
      },
      "assertions": [
        {
          "type": "status",
          "expected": 400
        }
      ]
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/constraints/conflicts",
        "body": {}
      },
      "assertions": [
        {
          "type": "status",
          "expected": 405
        }
      ]
    }
  ]
}
