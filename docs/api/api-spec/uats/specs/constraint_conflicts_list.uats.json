{
  "uats_version": "1.0.0",
  "api": {
    "name": "Constraint Conflicts List",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "constraints",
      "conflicts"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "List unresolved constraint conflicts (FSD-2026-001 GAP-04).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "constraints",
      "conflicts",
      "fsd"
    ],
    "sha256": "2cbaad459e3b0bb4007860199d7dbe334ac22531559a32a2e238b6f145b78fee"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/constraints/conflicts",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "space_id": "test-space"
    }
  },
  "expected": {
    "status": [
      200,
      503
    ],
    "body_assertions": [
      {
        "name": "total count when successful",
        "path": "$.total",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "total is not negative",
        "path": "$.total",
        "op": "greater_than_or_equal",
        "expected": 0,
        "optional": true
      },
      {
        "name": "conflicts is array when successful",
        "path": "$.conflicts",
        "op": "type_is",
        "expected": "array",
        "optional": true
      },
      {
        "name": "error field type when service unavailable",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "GET without space_id returns 400 or 503 if feature disabled",
      "expected": {
        "status": [
          400,
          503
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/constraints/conflicts",
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
