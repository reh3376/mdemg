{
  "uats_version": "1.0.0",
  "api": {
    "name": "Constraint Effectiveness Metrics",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "constraints",
      "metrics"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Query per-constraint effectiveness metrics (FSD-2026-001 GAP-03).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "constraints",
      "metrics",
      "fsd"
    ],
    "sha256": "aaf90330a165b47e8c6948847078210bb4984df231a4e70b25f7e20e8aa6a82e"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/constraints/effectiveness",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "space_id": "test-space"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "constraints array exists",
        "path": "$.constraints",
        "op": "exists"
      },
      {
        "name": "total is number",
        "path": "$.total",
        "op": "type_is",
        "expected": "number"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "GET without space_id returns 400",
      "request": {
        "query": null
      },
      "expected": {
        "status": 400
      }
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/constraints/effectiveness",
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
