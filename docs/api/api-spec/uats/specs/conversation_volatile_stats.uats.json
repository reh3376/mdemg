{
  "uats_version": "1.0.0",
  "api": {
    "name": "Volatile Stats",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "conversation",
      "volatile",
      "stats",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Volatile Stats endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "2af5eba579f434a3935f83635ca953f87e4910f738b35bc5d3e7075a9ad7b1b2",
    "tags": [
      "embedding_required"
    ]
  },
  "variables": {
    "test_space": "uats-volatile-test"
  },
  "request": {
    "method": "GET",
    "path": "/v1/conversation/volatile/stats",
    "query": {
      "space_id": "{{test_space}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.space_id",
        "type": "string"
      },
      {
        "path": "$.volatile_count",
        "type": "integer"
      },
      {
        "path": "$.permanent_count",
        "type": "integer"
      },
      {
        "path": "$.avg_volatile_stability",
        "type": "number"
      },
      {
        "path": "$.min_volatile_stability",
        "type": "number"
      },
      {
        "path": "$.max_volatile_stability",
        "type": "number"
      }
    ]
  }
}
