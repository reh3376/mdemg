{
  "uats_version": "1.0.0",
  "api": {
    "name": "Determinism Score",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "metrics",
      "determinism"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Compute behavioral determinism D-score (FSD-2026-001 GAP-09/GAP-19).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "metrics",
      "determinism",
      "fsd"
    ],
    "sha256": "38e1ec5175220c1f250274add8e8ce5e7c789d84ca6d6f2816c9e47d8b0bdb29"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/metrics/determinism",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "space_id": "test-space"
    }
  },
  "expected": {
    "status": [
      200,
      503
    ],
    "body_assertions": [
      {
        "name": "response has error or space_id field",
        "path": "$.space_id",
        "op": "exists"
      },
      {
        "name": "score is a number",
        "path": "$.score",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "score is not negative",
        "path": "$.score",
        "op": "greater_than_or_equal",
        "expected": 0
      },
      {
        "name": "total_actions is a number",
        "path": "$.total_actions",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "informed_actions is a number",
        "path": "$.informed_actions",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "compliance_rate is a number",
        "path": "$.compliance_rate",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "coverage_ratio is a number",
        "path": "$.coverage_ratio",
        "op": "type_is",
        "expected": "number"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "GET without space_id returns 400 or 503 if feature disabled",
      "expected": {
        "status": [
          400,
          503
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/metrics/determinism",
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
