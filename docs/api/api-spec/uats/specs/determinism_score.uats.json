{
  "uats_version": "1.0.0",
  "api": {
    "name": "Determinism Score",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": ["metrics", "determinism"]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Compute behavioral determinism D-score (FSD-2026-001 GAP-09/GAP-19).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": ["metrics", "determinism", "fsd"]
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/metrics/determinism",
    "headers": {
      "Content-Type": "application/json"
    },
    "query_params": {
      "space_id": "test-space"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "test-space",
      "score": 0,
      "informed_actions": 0,
      "total_actions": 0,
      "compliance_rate": 0,
      "coverage_ratio": 0
    }
  },
  "assertions": [
    {
      "type": "status",
      "expected": 200
    },
    {
      "type": "json_path",
      "path": "$.space_id",
      "op": "exists"
    },
    {
      "type": "json_path",
      "path": "$.score",
      "op": "gte",
      "expected": 0
    }
  ],
  "variants": [
    {
      "name": "missing_space_id",
      "description": "GET without space_id returns 400",
      "request": {
        "method": "GET",
        "path": "/v1/metrics/determinism"
      },
      "assertions": [
        {
          "type": "status",
          "expected": 400
        }
      ]
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/metrics/determinism",
        "body": {}
      },
      "assertions": [
        {
          "type": "status",
          "expected": 405
        }
      ]
    }
  ]
}
