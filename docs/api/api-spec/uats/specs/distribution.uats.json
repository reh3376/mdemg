{
  "uats_version": "1.0.0",
  "api": {
    "name": "Distribution Stats",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "stats",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Distribution Stats endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "9caabb558bb8ee2603bf81b637712f46d5fc82106bdd31763ea5ae998ff805ff"
  },
  "variables": {
    "test_space": "demo"
  },
  "request": {
    "method": "GET",
    "path": "/v1/memory/distribution",
    "query": {
      "space_id": "{{test_space}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.stats.space_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.stats.edge_count",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.stats.phase",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.stats.phase_thresholds",
        "op": "type_is",
        "expected": "object"
      },
      {
        "path": "$.history",
        "op": "type_is",
        "expected": "array"
      }
    ]
  }
}
