{
  "uats_version": "1.0.0",
  "api": {
    "name": "Frontier Detection",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "frontiers",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-12",
    "description": "Validates GET /v1/memory/frontiers identifies L3+ frontier nodes",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "ccdcf90627a19d1b4da1173601040a3da2fe9e6be9fd3beb01fb76503a29a40e"
  },
  "variables": {
    "test_space": "uats-frontier-test"
  },
  "request": {
    "method": "GET",
    "path": "/v1/memory/frontiers",
    "query": {
      "space_id": "{{test_space}}",
      "limit": "20"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.frontiers",
        "type": "array"
      },
      {
        "path": "$.count",
        "type": "integer"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "GET without space_id should return 400",
      "request": {
        "method": "GET",
        "path": "/v1/memory/frontiers",
        "query": {
          "space_id": ""
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/memory/frontiers",
        "body": {},
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
