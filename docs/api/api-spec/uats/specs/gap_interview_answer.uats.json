{
  "uats_version": "1.0.0",
  "api": {
    "name": "Answer Gap Interview",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "system",
      "gap-interviews",
      "write"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Validates POST /v1/system/gap-interviews/{prompt_id}/answer marks prompt answered",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "f0595fd7dd5ba598f3615909837ed89da18f9bf77524673b63a8250db4ec21c7"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/system/gap-interviews/nonexistent-prompt/answer",
    "body": {
      "observation_node_id": "test-node"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      500,
      503
    ],
    "body_assertions": [
      {
        "name": "status is answered when successful",
        "path": "$.status",
        "op": "equals",
        "expected": "answered",
        "optional": true
      },
      {
        "name": "prompt_id is string when successful",
        "path": "$.prompt_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when failed",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "GET should return 405 or 503",
      "request": {
        "method": "GET",
        "path": "/v1/system/gap-interviews/test-prompt/answer"
      },
      "expected": {
        "status": [
          405,
          503
        ],
        "body_assertions": []
      }
    }
  ]
}
