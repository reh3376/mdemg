{
  "uats_version": "1.0.0",
  "api": {
    "name": "Run Gap Interview",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "system",
      "gap-interviews",
      "write"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Validates POST /v1/system/gap-interviews/run triggers gap interview process",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 30000,
    "sha256": "96da89a443b23103e9988ae093958f8079fa63d8078a562991fe3356ccf72023"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/system/gap-interviews/run",
    "body": {
      "max_prompts": 5
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      503
    ],
    "body_assertions": [
      {
        "name": "total_gaps_analyzed is number when successful",
        "path": "$.total_gaps_analyzed",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "prompts_generated is number when successful",
        "path": "$.prompts_generated",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "prompts_generated is not negative",
        "path": "$.prompts_generated",
        "op": "greater_than_or_equal",
        "expected": 0,
        "optional": true
      },
      {
        "name": "error field type when service unavailable",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "GET should return 405",
      "request": {
        "method": "GET",
        "path": "/v1/system/gap-interviews/run"
      },
      "expected": {
        "status": [
          405,
          503
        ],
        "body_assertions": []
      }
    }
  ]
}
