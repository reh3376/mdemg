{
  "uats_version": "1.0.0",
  "api": {
    "name": "Gap Interview Stats",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "system",
      "gap-interviews",
      "stats",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Validates GET /v1/system/gap-interviews/stats returns interview statistics",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "4d6a33175656d80f9d59baa43656b777d96ae30f384a46570b02e0f7dc963f6e"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/system/gap-interviews/stats"
  },
  "expected": {
    "status": [
      200,
      503
    ],
    "body_assertions": [
      {
        "name": "total is number when successful",
        "path": "$.total",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "pending is number when successful",
        "path": "$.pending",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "answered is number when successful",
        "path": "$.answered",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "skipped is number when successful",
        "path": "$.skipped",
        "op": "type_is",
        "expected": "number",
        "optional": true
      },
      {
        "name": "error field type when service unavailable",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "POST should return 405 or 503",
      "request": {
        "method": "POST",
        "path": "/v1/system/gap-interviews/stats",
        "body": {}
      },
      "expected": {
        "status": [
          405,
          503
        ],
        "body_assertions": []
      }
    }
  ]
}
