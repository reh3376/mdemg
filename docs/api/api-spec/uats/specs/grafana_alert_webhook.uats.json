{
  "uats_version": "1.0.0",
  "api": {
    "name": "Grafana Alert Webhook",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": ["alert", "webhook", "sr001"]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-04-07",
    "description": "Validates Grafana alert webhook endpoint receives and processes alert payloads",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": ["alert"]
  },
  "request": {
    "method": "POST",
    "path": "/v1/alerts/grafana",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "alerts": [
        {
          "status": "firing",
          "labels": {
            "alertname": "UATS-Test",
            "severity": "low"
          },
          "annotations": {
            "summary": "UATS contract test"
          }
        }
      ]
    }
  },
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body_assertions": [
      {
        "path": "$.status",
        "op": "equals",
        "expected": "ok"
      }
    ]
  },
  "variants": [
    {
      "name": "empty_alerts_returns_200",
      "description": "POST with empty alerts array returns 200",
      "request": {
        "method": "POST",
        "path": "/v1/alerts/grafana",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "alerts": []
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body_assertions": [
          {
            "path": "$.status",
            "op": "equals",
            "expected": "ok"
          }
        ]
      }
    },
    {
      "name": "resolved_alert_returns_200",
      "description": "POST with resolved status alert returns 200",
      "request": {
        "method": "POST",
        "path": "/v1/alerts/grafana",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "alerts": [
            {
              "status": "resolved",
              "labels": {
                "alertname": "UATS-Resolved",
                "severity": "low"
              },
              "annotations": {
                "summary": "UATS resolved test"
              }
            }
          ]
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body_assertions": [
          {
            "path": "$.status",
            "op": "equals",
            "expected": "ok"
          }
        ]
      }
    }
  ]
}
