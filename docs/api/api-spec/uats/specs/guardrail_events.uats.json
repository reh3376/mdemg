{
  "uats_version": "1.0.0",
  "api": {
    "name": "Guardrail Events",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "guardrail",
      "enforcement",
      "fsd"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Query the guardrail enforcement event log (FSD-2026-001 GAP-01).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "guardrail",
      "enforcement",
      "fsd"
    ],
    "sha256": "1df1c72e2df27b74d490f346ac275f579f82dc65d0e680d1271c505fc542c950"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/guardrail/events",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "limit": "10"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "events array exists",
        "path": "$.events",
        "exists": true
      },
      {
        "name": "total is number",
        "path": "$.total",
        "type": "number"
      }
    ]
  },
  "variants": [
    {
      "name": "default_limit",
      "description": "GET events without explicit limit",
      "request": {
        "method": "GET",
        "path": "/v1/guardrail/events"
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "name": "events array exists",
            "path": "$.events",
            "exists": true
          }
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/guardrail/events",
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
