{
  "uats_version": "1.0.0",
  "api": {
    "name": "Guardrail Validate",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "guardrail",
      "validate",
      "phase104",
      "llm_required"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-02-24",
    "description": "Validates proposed code changes against active organizational constraints (Phase 104 Active MCP Guardrails).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "tags": [
      "guardrail",
      "validate",
      "phase104",
      "llm_required"
    ],
    "sha256": "bd32115bbf1e93ee570d6309b120b5c7d3909935c1f2a539cb6e42933569d33b"
  },
  "variables": {
    "space_id": "uats-test-space",
    "diff_content": "@@ -15,7 +15,7 @@\n func Login(c *gin.Context) {\n-    token := jwt.New()\n+    token := legacy_auth.GenerateToken()\n }"
  },
  "request": {
    "method": "POST",
    "path": "/v1/memory/guardrail/validate",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "{{space_id}}",
      "files_changed": [
        "src/api/auth.go"
      ],
      "diff": "{{diff_content}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.data.status",
        "op": "matches",
        "expected": "^(Pass|Warning|Block)$"
      },
      {
        "path": "$.data.violations",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.data.warnings",
        "op": "type_is",
        "expected": "array"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "Returns 400 when space_id is missing from request body.",
      "request": {
        "body": {
          "space_id": "",
          "files_changed": [
            "src/api/auth.go"
          ],
          "diff": "{{diff_content}}"
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "missing_diff",
      "description": "Returns 400 when diff is missing from request body.",
      "request": {
        "body": {
          "space_id": "{{space_id}}",
          "files_changed": [
            "src/api/auth.go"
          ],
          "diff": ""
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "missing_files_changed",
      "description": "Returns 400 when files_changed is missing from request body.",
      "request": {
        "body": {
          "space_id": "{{space_id}}",
          "files_changed": [],
          "diff": "{{diff_content}}"
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "async_producer_accepted",
      "description": "GUARDRAIL-PRODUCER-001: async:true never runs synchronously \u2014 returns 202 {queued} when the producer is enabled, 200 {disabled} when gated off, 200 {dropped} at concurrency capacity. All three are contract-valid; the response carries no verdict fields.",
      "request": {
        "body": {
          "async": true
        }
      },
      "expected": {
        "status": [
          200,
          202
        ],
        "body_assertions": [
          {
            "path": "$.status",
            "op": "one_of",
            "expected": [
              "queued",
              "disabled",
              "dropped"
            ]
          },
          {
            "path": "$.data",
            "op": "not_exists"
          }
        ]
      }
    }
  ]
}
