{
  "uats_version": "1.0.0",
  "api": {
    "name": "Hash Verification Revert",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "unts",
      "hash-verification"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Reverts a tracked file hash to a previous value",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "unts"
    ],
    "sha256": "fe966ba0344cc09fc1f53e749809cfe4ce306d76e0a3bdcff396956f2494d236"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/hash-verification/revert",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "path": "docs/api/api-spec/uats/specs/health.uats.json"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.path",
        "op": "equals",
        "expected": "docs/api/api-spec/uats/specs/health.uats.json"
      }
    ]
  },
  "variants": [
    {
      "name": "with_target_hash",
      "description": "Revert to a specific target hash",
      "request": {
        "body": {
          "path": "docs/api/api-spec/uats/specs/health.uats.json",
          "target_hash": "abc123"
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "path": "$.path",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "untracked_file",
      "description": "Reverting an untracked file returns 404",
      "request": {
        "body": {
          "path": "nonexistent/file.txt"
        }
      },
      "expected": {
        "status": 404,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "missing_path",
      "description": "Empty path returns 400",
      "request": {
        "body": {
          "path": ""
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "GET returns 405",
      "request": {
        "method": "GET",
        "path": "/v1/hash-verification/revert"
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
