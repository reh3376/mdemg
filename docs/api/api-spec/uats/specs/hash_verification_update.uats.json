{
  "uats_version": "1.0.0",
  "api": {
    "name": "Hash Verification Update",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "unts",
      "hash-verification"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Updates the tracked hash for a file in the verification registry",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "unts"
    ],
    "sha256": "e57a6b23c1cf596094ddc4c569d92ddb9204c886268852f9066a1babc2aa4267"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/hash-verification/update",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "path": "docs/api/api-spec/uats/specs/health.uats.json"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.path",
        "op": "equals",
        "expected": "docs/api/api-spec/uats/specs/health.uats.json"
      },
      {
        "path": "$.hash",
        "op": "exists",
        "expected": true
      }
    ]
  },
  "variants": [
    {
      "name": "with_explicit_hash",
      "description": "Update with explicit hash value",
      "request": {
        "body": {
          "path": "docs/api/api-spec/uats/specs/health.uats.json",
          "hash": "abc123def456",
          "source": "manual"
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "path": "$.path",
            "op": "equals",
            "expected": "docs/api/api-spec/uats/specs/health.uats.json"
          },
          {
            "path": "$.hash",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "missing_path",
      "description": "Update with empty path returns 400",
      "request": {
        "body": {
          "path": ""
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "GET returns 405",
      "request": {
        "method": "GET",
        "path": "/v1/hash-verification/update"
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
