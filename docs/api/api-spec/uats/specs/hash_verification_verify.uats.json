{
  "uats_version": "1.0.0",
  "api": {
    "name": "Hash Verification Verify Single",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "unts",
      "hash-verification"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Verifies a single tracked file against its expected hash",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "unts"
    ],
    "sha256": "572ae0d61db9d7441a560a8457f5625e34ca6954335c0bb724f81eb365c58d28"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/hash-verification/verify",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "path": "docs/api/api-spec/uats/specs/health.uats.json"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.path",
        "op": "equals",
        "expected": "docs/api/api-spec/uats/specs/health.uats.json"
      },
      {
        "path": "$.status",
        "op": "exists",
        "expected": true
      }
    ]
  },
  "variants": [
    {
      "name": "missing_path",
      "description": "Request with empty path returns 400",
      "request": {
        "body": {
          "path": ""
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "untracked_file",
      "description": "Verifying an untracked file returns 404",
      "request": {
        "body": {
          "path": "nonexistent/file.txt"
        }
      },
      "expected": {
        "status": 404,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists",
            "expected": true
          }
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "GET returns 405",
      "request": {
        "method": "GET",
        "path": "/v1/hash-verification/verify"
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
