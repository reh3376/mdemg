{
  "uats_version": "1.0.0",
  "api": {
    "name": "Cancel Ingest Job",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "ingest",
      "jobs",
      "write"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Cancel a running ingest job",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "sha256": "9f1f31d4a038fb2ad3406f13f5eb5f2bf905e6c762acca82da1a926f81719358"
  },
  "variables": {
    "job_id": "nonexistent-job-id"
  },
  "request": {
    "method": "POST",
    "path": "/v1/memory/ingest/cancel/{{job_id}}"
  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "name": "job_id is string when cancelled",
        "path": "$.job_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "status is cancelled when successful",
        "path": "$.status",
        "op": "equals",
        "expected": "cancelled",
        "optional": true
      },
      {
        "name": "error field type when not found",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  }
}
