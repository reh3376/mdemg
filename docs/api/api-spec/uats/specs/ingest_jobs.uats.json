{
  "uats_version": "1.0.0",
  "api": {
    "name": "List Ingest Jobs",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": ["memory", "ingest", "jobs", "read"]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-09",
    "description": "Validates GET /v1/memory/ingest/jobs returns ingestion job list",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/memory/ingest/jobs"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {"path": "$.jobs", "type": "array"},
      {"path": "$.count", "type": "integer"}
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/memory/ingest/jobs",
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
