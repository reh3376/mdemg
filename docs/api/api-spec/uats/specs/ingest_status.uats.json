{
  "uats_version": "1.0.0",
  "api": {
    "name": "Ingest Job Status",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "ingest",
      "jobs",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Get status of an ingest job",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
