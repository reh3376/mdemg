  },
  "expected": {
    "status": [
      200,
      404
    ],
    "body_assertions": [
      {
        "optional": true,
        "path": "$.job_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "optional": true,
        "path": "$.status",
        "op": "type_is",
        "expected": "string"
