{
  "uats_version": "1.0.0",
  "api": {
    "name": "Trigger Ingest Job",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "ingest",
      "jobs",
      "write"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Trigger Ingest Job endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "bd625331008426e60e6bdfda82074558983978aa1f9c779939843507e8cf6c3e"
  },
  "variables": {
    "test_space": "demo"
  },
  "request": {
    "method": "POST",
    "path": "/v1/memory/ingest/trigger",
    "body": {
      "space_id": "uats-ingest-{{$timestamp}}",
      "path": "/tmp"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      202
    ],
    "body_assertions": [
      {
        "path": "$.job_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.status",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.message",
        "op": "type_is",
        "expected": "string"
      }
    ]
  },
  "variants": [
    {
      "name": "forwarded_toggles_accepted",
      "description": "INGEST-TRIGGER-FORWARD-001: the four pointer-bool toggles (include_md/include_ts/include_py/archive_deleted) are honored request fields \u2014 accepted with dry_run and a job is created. Forwarding to CLI argv is pinned unit-side (TestBuildIngestConfigFromRequest_PointerBools); this contract locks the request schema.",
      "request": {
        "body": {
          "include_md": false,
          "include_ts": true,
          "include_py": false,
          "archive_deleted": false,
          "dry_run": true
        }
      },
      "expected": {
        "status": [
          200,
          202
        ],
        "body_assertions": [
          {
            "path": "$.job_id",
            "op": "exists"
          },
          {
            "path": "$.status",
            "op": "one_of",
            "expected": [
              "pending",
              "queued",
              "running"
            ]
          }
        ]
      }
    }
  ]
}
