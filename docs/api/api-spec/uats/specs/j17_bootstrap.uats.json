{
  "uats_version": "1.0.0",
  "api": {
    "name": "J17 Bootstrap",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "phase_j17"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-22",
    "description": "Validates the J17 bootstrap endpoint that returns initial protocol handshake data for new agent sessions.",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "phase_j17"
    ],
    "sha256": "fc734dcadfed4261adc4f1cc09a08ada4e8682e4a57e3ed0bfef0575c6f38c44"
  },
  "variables": {
    "space_id": "uats-test-space"
  },
  "request": {
    "method": "GET",
    "path": "/v1/jiminy/bootstrap",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "space_id": "{{space_id}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "data wrapper present",
        "path": "$.data",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "bootstrap payload is string",
        "path": "$.data.bootstrap",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "version is string",
        "path": "$.data.version",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "first_session is boolean",
        "path": "$.data.first_session",
        "op": "type_is",
        "expected": "boolean"
      }
    ]
  },
  "variants": [
    {
      "name": "j17_disabled",
      "description": "When J17 is disabled, bootstrap returns 503.",
      "tags": [
        "j17_disabled"
      ],
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "name": "error message present",
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      },
      "skip": true,
      "skip_reason": "Environment-conditional: passes only when the feature gate is OFF, but the live stack runs JIMINY_ENABLED=true + J17 enabled (HOOKWIRE-001 made the channel load-bearing). Documented contract retained: 503 when disabled. Converted to a skip variant in UATS-GAP-001 so the suite is green against the real deployment."
    }
  ]
}
