{
  "uats_version": "1.0.0",
  "api": {
    "name": "J17 Checkpoint",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "phase_j17"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-21",
    "description": "Validates the J17 checkpoint endpoint that issues session tickets for state persistence across context resets.",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "phase_j17"
    ],
    "sha256": "1acf97178d87f0fd3f12abc6707290b87428f37251c16bd39249343f5f3ae1b6"
  },
  "variables": {
    "space_id": "uats-test-space",
    "session_id": "uats-test"
  },
  "request": {
    "method": "POST",
    "path": "/v1/jiminy/checkpoint",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "{{space_id}}",
      "session_id": "{{session_id}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "data wrapper present",
        "path": "$.data",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "ticket present",
        "path": "$.data.ticket",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "ticket has payload",
        "path": "$.data.ticket.payload",
        "op": "exists"
      },
      {
        "name": "ticket has signature",
        "path": "$.data.ticket.signature",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "last_seq is number",
        "path": "$.data.last_seq",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "issued_at is string",
        "path": "$.data.issued_at",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "expires_at is string",
        "path": "$.data.expires_at",
        "op": "type_is",
        "expected": "string"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_space_id",
      "description": "Request without required space_id should return 400.",
      "request": {
        "body": {
          "space_id": "",
          "session_id": "{{session_id}}"
        }
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "name": "error message present",
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    },
    {
      "name": "j17_disabled",
      "description": "When J17 is disabled, checkpoint returns 503.",
      "tags": [
        "j17_disabled"
      ],
      "request": {
        "body": {
          "space_id": "{{space_id}}",
          "session_id": "{{session_id}}"
        }
      },
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "name": "error message present",
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    }
  ]
}
