{
  "uats_version": "1.0.0",
  "api": {
    "name": "J17 Protocol Metrics",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "metrics",
      "phase_j17"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-21",
    "description": "Validates the J17 protocol metrics endpoint that returns protocol performance snapshots for RSIC assessment.",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "metrics",
      "phase_j17"
    ],
    "sha256": "416619620cc6c3e39cdbb8857705292563f044d2fb0ce3f8501af92086c3d4e4"
  },
  "variables": {
    "space_id": "uats-test-space"
  },
  "request": {
    "method": "GET",
    "path": "/v1/jiminy/protocol/metrics",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "space_id": "{{space_id}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "data wrapper present",
        "path": "$.data",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "code_coverage is a number",
        "path": "$.data.code_coverage",
        "op": "type_is",
        "expected": "number"
      }
    ]
  },
  "variants": [
    {
      "name": "j17_disabled",
      "description": "When Jiminy is disabled, returns 503.",
      "tags": [
        "j17_disabled"
      ],
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "name": "error message present",
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      },
      "skip": true,
      "skip_reason": "Environment-conditional: passes only when the feature gate is OFF, but the live stack runs JIMINY_ENABLED=true + J17 enabled (HOOKWIRE-001 made the channel load-bearing). Documented contract retained: 503 when disabled. Converted to a skip variant in UATS-GAP-001 so the suite is green against the real deployment."
    }
  ]
}
