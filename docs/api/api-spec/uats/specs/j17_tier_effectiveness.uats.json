{
  "uats_version": "1.0.0",
  "api": {
    "name": "J17 Tier Effectiveness",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "tier_effectiveness",
      "nli_feedback_loop"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-23",
    "description": "Validates the J17 tier effectiveness endpoint that returns per-tier comprehension grading and NLI calibration data for RSIC feedback loop.",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "j17",
      "protocol",
      "tier_effectiveness",
      "nli_feedback_loop"
    ],
    "sha256": "6c5dcd779e87c3834488a65e101e07118b4641cbf9a7a05b338c5c7d46dd4203"
  },
  "variables": {
    "space_id": "uats-test-space"
  },
  "request": {
    "method": "GET",
    "path": "/v1/jiminy/protocol/tier-effectiveness",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "space_id": "{{space_id}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "data wrapper present",
        "path": "$.data",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "overall_tier_comprehension is array",
        "path": "$.data.overall_tier_comprehension",
        "op": "type_is",
        "expected": "array"
      },
      {
        "name": "tier_outcome_count is array",
        "path": "$.data.tier_outcome_count",
        "op": "type_is",
        "expected": "array"
      }
    ]
  },
  "variants": [
    {
      "name": "j17_disabled",
      "description": "When Jiminy is disabled, returns 503.",
      "tags": [
        "j17_disabled"
      ],
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "name": "error message present",
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      },
      "skip": true,
      "skip_reason": "Environment-conditional: passes only when the feature gate is OFF, but the live stack runs JIMINY_ENABLED=true + J17 enabled (HOOKWIRE-001 made the channel load-bearing). Documented contract retained: 503 when disabled. Converted to a skip variant in UATS-GAP-001 so the suite is green against the real deployment."
    }
  ]
}
