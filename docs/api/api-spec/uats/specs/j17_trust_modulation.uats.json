{
  "uats_version": "1.0.0",
  "api": {
    "name": "J17 Trust Modulation",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "j17",
      "trust",
      "phase_j17",
      "embedding_required"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-22",
    "description": "Validates the J17 trust modulation flow via the guide endpoint, ensuring protocol and guidance_seq fields reflect trust-aware responses.",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "tags": [
      "jiminy",
      "j17",
      "trust",
      "phase_j17",
      "embedding_required"
    ],
    "sha256": "2807a2d2d0c319168376dc64e4c7aacb5cc1ee74110be8b231c3f18317e0f5df"
  },
  "variables": {
    "space_id": "uats-test-space",
    "context_text": "test context",
    "session_id": "uats-trust-test"
  },
  "request": {
    "method": "POST",
    "path": "/v1/jiminy/guide",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "{{space_id}}",
      "context": "{{context_text}}",
      "session_id": "{{session_id}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "data wrapper present",
        "path": "$.data",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "protocol info present",
        "path": "$.data.protocol",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "protocol version is string",
        "path": "$.data.protocol.version",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "guidance_seq is number",
        "path": "$.data.guidance_seq",
        "op": "type_is",
        "expected": "number"
      }
    ]
  }
}
