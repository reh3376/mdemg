{
  "uats_version": "1.0.0",
  "api": {
    "name": "Jiminy Guidance Feedback",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "feedback",
      "phase_ar2",
      "effectiveness"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-18",
    "description": "Validates the Jiminy guidance feedback endpoint for effectiveness tracking (Phase AR-2).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "tags": [
      "jiminy",
      "feedback",
      "phase_ar2"
    ]
  },
  "variables": {
    "space_id": "uats-test-space",
    "guidance_id": "uats-test-guid-0001"
  },
  "request": {
    "method": "POST",
    "path": "/v1/jiminy/feedback",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "guidance_id": "",
      "action_summary": "test action",
      "space_id": "{{space_id}}"
    }
  },
  "expected": {
    "status": 400,
    "body_assertions": [
      {
        "name": "error message present",
        "path": "$.error",
        "exists": true
      }
    ]
  },
  "variants": [
    {
      "name": "valid_feedback",
      "description": "Returns 200 when guidance_id is provided (even if unknown — graceful handling).",
      "request": {
        "body": {
          "guidance_id": "{{guidance_id}}",
          "action_summary": "I validated the input",
          "space_id": "{{space_id}}"
        }
      },
      "expected": {
        "status": [200, 503],
        "body_assertions": []
      }
    },
    {
      "name": "method_not_allowed_get",
      "description": "Returns 405 when using GET method instead of POST.",
      "request": {
        "method": "GET",
        "path": "/v1/jiminy/feedback",
        "body": null
      },
      "expected": {
        "status": 405,
        "body_assertions": [
          {
            "name": "error message present",
            "path": "$.error",
            "exists": true
          }
        ]
      }
    },
    {
      "name": "disabled_service",
      "description": "Returns 503 when JIMINY_ENABLED is false, or 400 if enabled but guidance_id empty.",
      "request": {
        "body": {
          "guidance_id": "",
          "action_summary": "test",
          "space_id": "{{space_id}}"
        }
      },
      "expected": {
        "status": [400, 503],
        "body_assertions": []
      }
    }
  ]
}
