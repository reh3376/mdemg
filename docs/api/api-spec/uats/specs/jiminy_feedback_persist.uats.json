{
  "uats_version": "1.0.0",
  "api": {
    "name": "Jiminy Feedback Persistence",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "effectiveness"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Verify guidance feedback is persisted and correlates outcomes (FSD-2026-001 GAP-03).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "effectiveness",
      "fsd"
    ],
    "sha256": "4f1c16955e5631299f1042c9a7c49327f00f79353b87d520b5feb0aceecf9aad"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/jiminy/feedback",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "guidance_id": "test-guidance-id",
      "action_summary": "followed the constraint about error handling",
      "space_id": "test-space"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "guidance_id echoed",
        "path": "$.data.guidance_id",
        "equals": "test-guidance-id"
      },
      {
        "name": "results array exists",
        "path": "$.data.results",
        "exists": true
      }
    ]
  },
  "variants": [
    {
      "name": "missing_guidance_id",
      "description": "POST without guidance_id returns 400",
      "request": {
        "body": {
          "guidance_id": "",
          "action_summary": "something",
          "space_id": "test"
        }
      },
      "expected": {
        "status": 400
      }
    }
  ]
}
