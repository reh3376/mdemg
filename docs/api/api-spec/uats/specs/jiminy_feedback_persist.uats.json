{
  "uats_version": "1.0.0",
  "api": {
    "name": "Jiminy Feedback Persistence",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "effectiveness"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Verify guidance feedback is persisted and correlates outcomes (FSD-2026-001 GAP-03).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "effectiveness",
      "fsd"
    ],
    "sha256": "b343c95b611be0cc0ab4cb8c046f6911c1be19746e72ab0d13d9366482af2072"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/jiminy/feedback",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "guidance_id": "test-guidance-id",
      "action_summary": "followed the constraint about error handling",
      "space_id": "test-space"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "guidance_id echoed",
        "path": "$.data.guidance_id",
        "op": "equals",
        "expected": "test-guidance-id"
      },
      {
        "name": "results array exists",
        "path": "$.data.results",
        "op": "exists"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_guidance_id",
      "description": "POST without guidance_id returns 400",
      "request": {
        "body": {
          "guidance_id": "",
          "action_summary": "something",
          "space_id": "test"
        }
      },
      "expected": {
        "status": 400
      }
    }
  ]
}
