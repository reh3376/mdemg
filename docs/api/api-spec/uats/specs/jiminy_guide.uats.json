{
  "uats_version": "1.0.0",
  "api": {
    "name": "Jiminy Guide",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "guidance",
      "phase_jiminy",
      "embedding_required"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-12",
    "description": "Validates the Jiminy guidance endpoint that provides proactive inner-voice guidance drawn from MDEMG's knowledge graph (constraints, corrections, patterns, contradictions, frontiers).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "tags": [
      "jiminy",
      "guidance",
      "phase_jiminy",
      "embedding_required"
    ],
    "sha256": "19f98c32817fc93166561536286f45be0fc5234ce6d96e39e1d1cb9849c6ec1c"
  },
  "variables": {
    "space_id": "uats-test-space",
    "context_text": "Refactoring authentication middleware to use new JWT library"
  },
  "request": {
    "method": "POST",
    "path": "/v1/jiminy/guide",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "{{space_id}}",
      "context": "{{context_text}}",
      "session_id": "uats-test"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "data wrapper present",
        "path": "$.data",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "guidance is array",
        "path": "$.data.guidance",
        "op": "type_is",
        "expected": "array"
      },
      {
        "name": "prompt_augmentation is string",
        "path": "$.data.prompt_augmentation",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "confidence is number",
        "path": "$.data.confidence",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "source_counts present",
        "path": "$.data.source_counts",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "rationale is string",
        "path": "$.data.rationale",
        "op": "type_is",
        "expected": "string"
      }
    ]
  },
  "variants": [
    {
      "name": "with_file_path",
      "description": "Request with optional file_path for file-specific guidance.",
      "request": {
        "body": {
          "space_id": "{{space_id}}",
          "context": "{{context_text}}",
          "file_path": "internal/auth/middleware.go",
          "session_id": "uats-test"
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "name": "data wrapper present",
            "path": "$.data",
            "op": "type_is",
            "expected": "object"
          },
          {
            "name": "guidance is array",
            "path": "$.data.guidance",
            "op": "type_is",
            "expected": "array"
          }
        ]
      }
    },
    {
      "name": "with_agent_output",
      "description": "Request with optional agent_output for reviewing proposed code.",
      "request": {
        "body": {
          "space_id": "{{space_id}}",
          "context": "{{context_text}}",
          "agent_output": "func NewAuthMiddleware(secret string) gin.HandlerFunc { ... }",
          "session_id": "uats-test"
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "name": "data wrapper present",
            "path": "$.data",
            "op": "type_is",
            "expected": "object"
          },
          {
            "name": "guidance is array",
            "path": "$.data.guidance",
            "op": "type_is",
            "expected": "array"
          }
        ]
      }
    },
    {
      "name": "with_max_items",
      "description": "Request with custom max_items limit.",
      "request": {
        "body": {
          "space_id": "{{space_id}}",
          "context": "{{context_text}}",
          "max_items": 3
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "name": "data wrapper present",
            "path": "$.data",
            "op": "type_is",
            "expected": "object"
          },
          {
            "name": "guidance is array",
            "path": "$.data.guidance",
            "op": "type_is",
            "expected": "array"
          }
        ]
      }
    }
  ]
}
