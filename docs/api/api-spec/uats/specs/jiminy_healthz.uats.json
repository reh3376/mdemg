{
  "uats_version": "1.0.0",
  "api": {
    "name": "Jiminy Healthz",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "health",
      "liveness"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-24",
    "description": "Validates Jiminy healthz liveness endpoint \u2014 returns enabled/disabled status",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "jiminy",
      "health"
    ],
    "sha256": "248f50c850de6eb6c72c85296410cf609ff2fec318f9b29fd9ff79328cd8fdf6"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/jiminy/healthz",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "status is string",
        "path": "$.status",
        "op": "type_is",
        "expected": "string"
      },
      {
        "name": "enabled is boolean",
        "path": "$.enabled",
        "op": "type_is",
        "expected": "boolean"
      }
    ]
  },
  "variants": [
    {
      "name": "jiminy_disabled",
      "description": "When Jiminy is disabled, returns 503 with disabled status.",
      "tags": [
        "jiminy_disabled"
      ],
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "name": "status is disabled",
            "path": "$.status",
            "op": "equals",
            "expected": "disabled"
          },
          {
            "name": "enabled is false",
            "path": "$.enabled",
            "op": "equals",
            "expected": false
          }
        ]
      },
      "skip": true,
      "skip_reason": "Environment-conditional: passes only when the feature gate is OFF, but the live stack runs JIMINY_ENABLED=true + J17 enabled (HOOKWIRE-001 made the channel load-bearing). Documented contract retained: 503 when disabled. Converted to a skip variant in UATS-GAP-001 so the suite is green against the real deployment."
    }
  ]
}
