{
  "uats_version": "1.0.0",
  "api": {
    "name": "Jiminy Ready",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "jiminy",
      "readiness",
      "features"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-24",
    "description": "Validates Jiminy readiness endpoint — reports features, services, config, and optional stats",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "jiminy",
      "readiness"
    ],
    "sha256": "1c931b79bf1104fc8cbbd90c9826b0c075e429ad5e6a12026fb95f832ffffd3c"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/jiminy/ready",
    "headers": {
      "Content-Type": "application/json"
    },
    "query": {
      "stats": "true"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "status is ready",
        "path": "$.status",
        "op": "equals",
        "expected": "ready"
      },
      {
        "name": "enabled is true",
        "path": "$.enabled",
        "op": "equals",
        "expected": true
      },
      {
        "name": "features is object",
        "path": "$.features",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "services is object",
        "path": "$.services",
        "op": "type_is",
        "expected": "object"
      },
      {
        "name": "config is object",
        "path": "$.config",
        "op": "type_is",
        "expected": "object"
      }
    ]
  },
  "variants": [
    {
      "name": "jiminy_disabled",
      "description": "When Jiminy is disabled, returns 503 with disabled status and message.",
      "tags": [
        "jiminy_disabled"
      ],
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "name": "status is disabled",
            "path": "$.status",
            "op": "equals",
            "expected": "disabled"
          },
          {
            "name": "message contains JIMINY_ENABLED",
            "path": "$.message",
            "op": "contains",
            "expected": "JIMINY_ENABLED"
          }
        ]
      }
    }
  ]
}
