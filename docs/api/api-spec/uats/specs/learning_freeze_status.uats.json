{
  "uats_version": "1.0.0",
  "api": {
    "name": "Learning Freeze Status",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "learning",
      "freeze",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Learning Freeze Status endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "8aa16f65955c532727dc4dd951a2d4844f1c849023732f891af4243a0b6de78d"
  },
  "variables": {
    "test_space": "uats-freeze-status-test"
  },
  "request": {
    "method": "GET",
    "path": "/v1/learning/freeze/status",
    "query": {
      "space_id": "{{test_space}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.state",
        "op": "type_is",
        "expected": "object"
      },
      {
        "path": "$.state.frozen",
        "op": "type_is",
        "expected": "boolean"
      }
    ]
  }
}
