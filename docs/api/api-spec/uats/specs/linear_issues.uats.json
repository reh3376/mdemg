{
  "uats_version": "1.0.0",
  "api": {
    "name": "Linear Issues",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "linear",
      "issues",
      "crud"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Validates /v1/linear/issues CRUD operations",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "54c43a4c7894d32f58b087bcf90a191c94a6ac0048d920b1e7d271b0b7829a68"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/linear/issues"
  },
  "expected": {
    "status": 503,
    "body_assertions": [
      {
        "path": "$.error",
        "op": "type_is",
        "expected": "string"
      }
    ]
  },
  "variants": [
    {
      "name": "create_unavailable",
      "description": "POST without Linear module returns 503",
      "request": {
        "method": "POST",
        "path": "/v1/linear/issues",
        "body": {
          "title": "test issue",
          "team_id": "test-team"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    },
    {
      "name": "read_unavailable",
      "description": "GET single issue without Linear module returns 503",
      "request": {
        "method": "GET",
        "path": "/v1/linear/issues/nonexistent-id"
      },
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    },
    {
      "name": "delete_unavailable",
      "description": "DELETE without Linear module returns 503",
      "request": {
        "method": "DELETE",
        "path": "/v1/linear/issues/nonexistent-id"
      },
      "expected": {
        "status": 503,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    },
    {
      "name": "patch_not_allowed",
      "description": "PATCH should return 405 or 503 (module check precedes method check)",
      "request": {
        "method": "PATCH",
        "path": "/v1/linear/issues",
        "body": {}
      },
      "expected": {
        "status": [
          405,
          503
        ],
        "body_assertions": [
          {
            "path": "$.error",
            "op": "type_is",
            "expected": "string"
          }
        ]
      }
    }
  ]
}
