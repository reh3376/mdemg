{
  "uats_version": "1.0.0",
  "api": {
    "name": "Metrics Trends",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "metrics",
      "tsdb",
      "trends",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-27",
    "description": "Validates historical metric trend queries against TimescaleDB",
    "test_type": "contract",
    "priority": "medium",
    "phase": "tsdb-sprint",
    "requires_tsdb": true
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "097c597b2a32e5ccf1accc30ded5843d614c75ba815928904c6639764969d8b9"
  },
  "variables": {
    "test_space": "mdemg-dev",
    "metric": "rsic_health_overall",
    "trend_from": "2026-03-01T00:00:00Z",
    "trend_to": "2026-03-27T23:59:59Z",
    "granularity": "daily"
  },
  "request": {
    "method": "GET",
    "path": "/v1/metrics/trends",
    "query": {
      "space_id": "{{test_space}}",
      "metric": "{{metric}}",
      "from": "{{trend_from}}",
      "to": "{{trend_to}}",
      "granularity": "{{granularity}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$",
        "op": "type_is",
        "expected": "array"
      }
    ]
  },
  "variants": []
}
