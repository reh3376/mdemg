{
  "uats_version": "1.0.0",
  "api": {
    "name": "Neural Sidecar NLI",
    "base_url": "${NEURAL_SIDECAR_URL}",
    "version": "v1",
    "service": "neural-sidecar",
    "tags": [
      "neural",
      "nli",
      "sidecar"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "NLI entailment/contradiction/neutral classification via neural sidecar (NR-2).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "neural",
      "nli",
      "sidecar",
      "fsd"
    ]
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/nli",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "premise": "You must always use error handling in Go",
      "hypothesis": "Error handling should be skipped for performance"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "label": "",
      "scores": {
        "entailment": 0,
        "contradiction": 0,
        "neutral": 0
      },
      "model": "",
      "latency_ms": 0
    }
  },
  "assertions": [
    {
      "type": "status",
      "expected": 200
    },
    {
      "type": "json_path",
      "path": "$.label",
      "op": "exists"
    },
    {
      "type": "json_path",
      "path": "$.scores.entailment",
      "op": "gte",
      "expected": 0
    },
    {
      "type": "json_path",
      "path": "$.scores.contradiction",
      "op": "gte",
      "expected": 0
    },
    {
      "type": "json_path",
      "path": "$.scores.neutral",
      "op": "gte",
      "expected": 0
    },
    {
      "type": "json_path",
      "path": "$.model",
      "op": "exists"
    },
    {
      "type": "json_path",
      "path": "$.latency_ms",
      "op": "gte",
      "expected": 0
    }
  ],
  "variants": [
    {
      "name": "entailment_pair",
      "description": "Paraphrased pair should show high entailment",
      "request": {
        "method": "POST",
        "path": "/nli",
        "body": {
          "premise": "All API handlers must validate input",
          "hypothesis": "Input validation is required in API handlers"
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": 200
        },
        {
          "type": "json_path",
          "path": "$.label",
          "op": "exists"
        }
      ]
    },
    {
      "name": "validation_error_missing_hypothesis",
      "description": "POST without hypothesis returns 422",
      "request": {
        "method": "POST",
        "path": "/nli",
        "body": {
          "premise": "test"
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": 422
        }
      ]
    },
    {
      "name": "validation_error_missing_premise",
      "description": "POST without premise returns 422",
      "request": {
        "method": "POST",
        "path": "/nli",
        "body": {
          "hypothesis": "test"
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": 422
        }
      ]
    }
  ]
}
