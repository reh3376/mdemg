{
  "uats_version": "1.0.0",
  "api": {
    "name": "Neural Sidecar Rerank",
    "base_url": "${NEURAL_SIDECAR_URL}",
    "version": "v1",
    "service": "neural-sidecar",
    "tags": [
      "neural",
      "rerank",
      "sidecar"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Cross-encoder re-ranking via neural sidecar (NR-2).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "neural",
      "rerank",
      "sidecar",
      "fsd"
    ],
    "sha256": "ba0349d3262b0d3bdcedb25cd48611efa78da664b5fef6c6f1367dfc445285a1"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/rerank",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "query": "how to handle errors in Go",
      "documents": [
        "Error handling in Go uses explicit return values",
        "Logging configuration and setup guide",
        "Retry patterns and circuit breakers for resilience"
      ],
      "top_n": 3
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "results": [],
      "model": "",
      "latency_ms": 0
    }
  },
  "assertions": [
    {
      "type": "status",
      "expected": 200
    },
    {
      "type": "json_path",
      "path": "$.results",
      "op": "exists"
    },
    {
      "type": "json_path",
      "path": "$.model",
      "op": "exists"
    },
    {
      "type": "json_path",
      "path": "$.latency_ms",
      "op": "gte",
      "expected": 0
    }
  ],
  "variants": [
    {
      "name": "top_n_1",
      "description": "Rerank with top_n=1 returns single result",
      "request": {
        "method": "POST",
        "path": "/rerank",
        "body": {
          "query": "database migration",
          "documents": [
            "Schema migration runner",
            "API handler patterns"
          ],
          "top_n": 1
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": 200
        },
        {
          "type": "json_path",
          "path": "$.results",
          "op": "exists"
        }
      ]
    },
    {
      "name": "validation_error_missing_query",
      "description": "POST without query returns 422",
      "request": {
        "method": "POST",
        "path": "/rerank",
        "body": {
          "documents": [
            "doc1"
          ]
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": 422
        }
      ]
    },
    {
      "name": "validation_error_top_n_zero",
      "description": "POST with top_n=0 returns 422",
      "request": {
        "method": "POST",
        "path": "/rerank",
        "body": {
          "query": "test",
          "documents": [
            "doc1"
          ],
          "top_n": 0
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": 422
        }
      ]
    }
  ]
}
