{
  "uats_version": "1.0.0",
  "api": {
    "name": "Neural Sidecar Rerank",
    "base_url": "${NEURAL_SIDECAR_URL}",
    "version": "v1",
    "service": "neural-sidecar",
    "tags": [
      "neural",
      "rerank",
      "sidecar"
    ]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Cross-encoder re-ranking via neural sidecar (NR-2).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "neural",
      "rerank",
      "sidecar",
      "fsd",
      "sidecar_required"
    ],
    "sha256": "c946525dec750afc31419bff41646989cebb16bb1b16db7b8379cadc3958befb"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/rerank",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "query": "how to handle errors in Go",
      "documents": [
        "Error handling in Go uses explicit return values",
        "Logging configuration and setup guide",
        "Retry patterns and circuit breakers for resilience"
      ],
      "top_n": 3
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "results exists",
        "path": "$.results",
        "op": "exists"
      },
      {
        "name": "model exists",
        "path": "$.model",
        "op": "exists"
      },
      {
        "name": "latency_ms is number",
        "path": "$.latency_ms",
        "op": "type_is",
        "expected": "number"
      }
    ]
  },
  "variants": [
    {
      "name": "top_n_1",
      "description": "Rerank with top_n=1 returns single result",
      "request": {
        "body": {
          "query": "database migration",
          "documents": [
            "Schema migration runner",
            "API handler patterns"
          ],
          "top_n": 1
        }
      },
      "expected": {
        "status": 200,
        "body_assertions": [
          {
            "name": "results exists",
            "path": "$.results",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "validation_error_missing_query",
      "description": "POST without query returns 422",
      "request": {
        "body": {
          "documents": [
            "doc1"
          ]
        }
      },
      "expected": {
        "status": 422
      }
    },
    {
      "name": "validation_error_top_n_zero",
      "description": "POST with top_n=0 returns 422",
      "request": {
        "body": {
          "query": "test",
          "documents": [
            "doc1"
          ],
          "top_n": 0
        }
      },
      "expected": {
        "status": 422
      }
    }
  ]
}
