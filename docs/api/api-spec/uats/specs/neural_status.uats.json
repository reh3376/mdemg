{
  "uats_version": "1.0.0",
  "api": {
    "name": "Neural Sidecar Status",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": ["neural", "observability"]
  },
  "metadata": {
    "author": "agent",
    "created": "2026-03-19",
    "description": "Query neural sidecar status and collection stats (NR-3).",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": ["neural", "observability"]
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/neural/status",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "sidecar_enabled": false,
      "neural_rerank_enabled": false,
      "data_collection_enabled": false
    }
  },
  "assertions": [
    {
      "type": "status",
      "expected": 200
    },
    {
      "type": "json_path",
      "path": "$.sidecar_enabled",
      "op": "exists"
    }
  ],
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "POST should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/neural/status",
        "body": {}
      },
      "assertions": [
        {
          "type": "status",
          "expected": 405
        }
      ]
    }
  ]
}
