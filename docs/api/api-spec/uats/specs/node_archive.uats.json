    "created": "2026-03-10",
    "description": "Validates POST /v1/memory/nodes/{node_id}/archive archives a memory node",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "7c909208dfc379631d53f0b13da7ea111e6c5d623b1a5ff3adf5b8e001e62bcf"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/memory/nodes/nonexistent-uats-node/archive",
    "body": {
      "reason": "uats test"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": [
      200,
      404,
      500
    ],
    "body_assertions": [
      {
        "name": "node_id present when archived",
        "path": "$.node_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "archived_at present when archived",
        "path": "$.archived_at",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when failed",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
