{
  "uats_version": "1.0.0",
  "api": {
    "name": "Node Meta",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "node",
      "meta"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-25",
    "description": "Validates GET /v1/memory/node/meta endpoint for content-hash change detection",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000
  },
  "variables": {
    "test_space": "mdemg-dev"
  },
  "request": {
    "method": "GET",
    "path": "/v1/memory/node/meta",
    "query": {
      "space_id": "{{test_space}}",
      "path": "nonexistent-file.md"
    }
  },
  "expected": {
    "status": 404,
    "body_assertions": [
      {
        "path": "$.error",
        "op": "equals",
        "expected": "node not found"
      },
      {
        "path": "$.path",
        "op": "equals",
        "expected": "nonexistent-file.md"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_params",
      "description": "Returns 400 when required query params are missing",
      "request": {
        "method": "GET",
        "path": "/v1/memory/node/meta"
      },
      "expected": {
        "status": 400,
        "body_assertions": [
          {
            "path": "$.error",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "method_not_allowed",
      "description": "Returns 405 for POST requests",
      "request": {
        "method": "POST",
        "path": "/v1/memory/node/meta",
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
