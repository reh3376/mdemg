{
  "uats_version": "1.0.0",
  "api": {
    "name": "Unarchive Node",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "nodes",
      "unarchive",
      "write"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Validates POST /v1/memory/nodes/{node_id}/unarchive restores an archived node",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "fa1ef5cbb9d22c7d834f25888edb949302d861d2960509f77f7a82f451cac873"
  },
  "variables": {},
  "request": {
    "method": "POST",
    "path": "/v1/memory/nodes/nonexistent-uats-node/unarchive"
  },
  "expected": {
    "status": [
      200,
      404,
      500
    ],
    "body_assertions": [
      {
        "name": "node_id present when unarchived",
        "path": "$.node_id",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "unarchived_at present when unarchived",
        "path": "$.unarchived_at",
        "op": "type_is",
        "expected": "string",
        "optional": true
      },
      {
        "name": "error field type when failed",
        "path": "$.error",
        "op": "type_is",
        "expected": "string",
        "optional": true
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "GET should return 405",
      "request": {
        "method": "GET",
        "path": "/v1/memory/nodes/test-node/unarchive"
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
