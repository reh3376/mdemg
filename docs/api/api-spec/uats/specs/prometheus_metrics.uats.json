{
  "uats_version": "1.0.0",
  "api": {
    "name": "Prometheus Metrics",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "observability",
      "prometheus",
      "metrics"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-10",
    "description": "Returns Prometheus-format metrics (plain text, no JSON body assertions)",
    "test_type": "contract",
    "priority": "low"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "bcebc22c5693801a1dfc7b7cd8c6d2a557efe0d1c72f6fc8efd6b6fa945c186d"
  },
  "variables": {},
  "request": {
    "method": "GET",
    "path": "/v1/prometheus"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "response body is not empty",
        "path": "$",
        "op": "not_equals",
        "expected": ""
      },
      {
        "name": "response body exists",
        "path": "$",
        "op": "exists"
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "POST returns 405",
      "request": {
        "method": "POST",
        "path": "/v1/prometheus",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      },
      "expected": {
        "status": 405
      }
    }
  ]
}
