  "metadata": {
    "author": "reh3376",
    "created": "2026-03-23",
    "description": "Validates RSIC-SK1 guidance self-calibration: cycle endpoint accepts review_guidance_effectiveness, adjust_guidance_confidence, and archive_ineffective_constraints action types without unknown-action errors",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 30000,
    "tags": [
      "rsic",
      "rsic-sk1"
    ],
    "sha256": "1bc4fa4775db0e3b180ad7849a44e13643d58d5d1dba06ea72746d261e687bf3"
  },
  "variables": {
    "test_space": "uats-rsic-sk1-test"
