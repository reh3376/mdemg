      "tier": "micro"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.cycle_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.tier",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string"
      }
    ]
  }
