{
  "uats_version": "1.0.0",
  "api": {
    "name": "Phase 88 - Self-Improve Cycle Dry Run",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "rsic",
      "phase88",
      "safety",
      "dry-run"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-02-16",
    "description": "Validates dry-run mode on POST /v1/self-improve/cycle returns safety_version and dry_run fields with zero mutations.",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 30000,
    "tags": [
      "rsic"
    ],
    "sha256": "45a6481f12e8bc1d05c1f02889d0f88c131abfdcd8c9bb29498d0f46fca0275b"
  },
  "variables": {
    "test_space": "uats-rsic-phase88-dryrun",
    "idempotency_key": {
      "generator": "uuid"
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/self-improve/cycle",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "space_id": "{{test_space}}",
      "tier": "meso",
      "dry_run": true,
      "idempotency_key": "{{idempotency_key}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.cycle_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.tier",
        "op": "equals",
        "expected": "meso"
      },
      {
        "path": "$.dry_run",
        "op": "equals",
        "expected": true
      },
      {
        "path": "$.safety_version",
        "op": "equals",
        "expected": "phase88-v1"
      },
      {
        "path": "$.actions_executed",
        "op": "equals",
        "expected": 0
      }
    ]
  }
}
