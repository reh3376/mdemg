{
  "uats_version": "1.0.0",
  "api": {
    "name": "Phase 88 - Self-Improve Health Safety Block",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "rsic",
      "phase88",
      "safety",
      "health"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-02-16",
    "description": "Validates GET /v1/self-improve/health includes safety enforcement block with bounds, rollback state, and version.",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "rsic"
    ],
    "sha256": "69b9fd916a617309451370354a0d05c807eab896691b595837acd017833b4f0f"
  },
  "request": {
    "method": "GET",
    "path": "/v1/self-improve/health"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.status",
        "op": "equals",
        "expected": "ok"
      },
      {
        "path": "$.safety.enforcement_active",
        "op": "equals",
        "expected": true
      },
      {
        "path": "$.safety.safety_version",
        "op": "equals",
        "expected": "phase88-v1"
      },
      {
        "path": "$.safety.bounds.max_nodes_affected",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.safety.bounds.max_edges_affected",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.safety.bounds.protected_spaces",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.safety.rollback.window_sec",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.safety.rollback.snapshots_held",
        "op": "type_is",
        "expected": "number"
      }
    ]
  }
}
