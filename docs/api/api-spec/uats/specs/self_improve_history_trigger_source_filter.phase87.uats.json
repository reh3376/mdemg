{
  "uats_version": "1.0.0",
  "api": {
    "name": "Phase 87 - Self-Improve History Trigger Source Filter",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "rsic",
      "phase87",
      "history",
      "filtering"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-22",
    "description": "Validates trigger-source filtering contract for GET /v1/self-improve/history (Phase 87 design draft).",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 10000,
    "tags": [
      "rsic"
    ],
    "sha256": "53242be5119e4dce6a57feef390bb15902a8cea253bbab157de9b52c2cbe24d7"
  },
  "request": {
    "method": "GET",
    "path": "/v1/self-improve/history",
    "query": {
      "space_id": "uats-rsic-phase87",
      "tier": "meso",
      "trigger_source": "manual_api",
      "limit": "5"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.history",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.count",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.filters",
        "op": "type_is",
        "expected": "object"
      },
      {
        "path": "$.filters.space_id",
        "op": "equals",
        "expected": "uats-rsic-phase87"
      },
      {
        "path": "$.filters.tier",
        "op": "equals",
        "expected": "meso"
      },
      {
        "path": "$.filters.trigger_source",
        "op": "equals",
        "expected": "manual_api"
      }
    ]
  }
}
