{
  "uats_version": "1.0.0",
  "api": {
    "name": "Self-Improve Report By Task ID",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "rsic",
      "self-improve",
      "report"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-23",
    "description": "Validates RSIC per-task report endpoint returns task_id and reports array for any task ID.",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 5000,
    "tags": [
      "rsic"
    ],
    "sha256": "2b844ee0f064ec0b28c98eb5bcc35d8ba8cca905860de7fda23d105c76a4da15"
  },
  "request": {
    "method": "GET",
    "path": "/v1/self-improve/report/nonexistent-task-id"
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.task_id",
        "type": "string",
        "equals": "nonexistent-task-id"
      },
      {
        "path": "$.reports",
        "type": "array"
      }
    ]
  },
  "variants": [
    {
      "name": "method_not_allowed",
      "description": "POST to report/{taskID} should return 405",
      "request": {
        "method": "POST",
        "path": "/v1/self-improve/report/nonexistent-task-id",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      },
      "expected": {
        "status": 405,
        "body_assertions": []
      }
    }
  ]
}
