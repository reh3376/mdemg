{
  "uats_version": "1.0.0",
  "api": {
    "name": "List Registered Skills",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "skills",
      "list",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-02-07",
    "description": "Validates that GET /v1/skills returns registered skills from pinned observations",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "sha256": "16c0e13ea7f67293f5cbc9d21d466a394090f6681032b78b32492b0dd78118cb"
  },
  "variables": {
    "test_space": "uats-skills-test"
  },
  "request": {
    "method": "GET",
    "path": "/v1/skills?space_id={{test_space}}",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.skills",
        "op": "type_is",
        "expected": "array"
      },
      {
        "path": "$.count",
        "op": "type_is",
        "expected": "number"
      }
    ]
  }
}
