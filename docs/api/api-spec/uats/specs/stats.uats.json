{
  "uats_version": "1.0.0",
  "api": {
    "name": "Memory Stats",
    "base_url": "${MDEMG_BASE_URL}",
    "version": "v1",
    "service": "mdemg",
    "tags": [
      "memory",
      "stats",
      "read"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-01-29",
    "description": "Validates Memory Stats endpoint",
    "test_type": "contract",
    "priority": "medium"
  },
  "config": {
    "timeout_ms": 15000,
    "tags": [
      "embedding_required"
    ],
    "sha256": "e6810e542363cf90c57566f3a45db742f019bfcbfe6d8ca7c6e3e2344d5d730d"
  },
  "variables": {
    "test_space": "demo"
  },
  "request": {
    "method": "GET",
    "path": "/v1/memory/stats",
    "query": {
      "space_id": "{{test_space}}"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "path": "$.space_id",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.memory_count",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.observation_count",
        "op": "type_is",
        "expected": "integer"
      },
      {
        "path": "$.embedding_coverage",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.health_score",
        "op": "type_is",
        "expected": "number"
      },
      {
        "path": "$.computed_at",
        "op": "type_is",
        "expected": "string"
      },
      {
        "path": "$.learning_activity",
        "op": "type_is",
        "expected": "object"
      },
      {
        "path": "$.temporal_distribution",
        "op": "type_is",
        "expected": "object"
      },
      {
        "path": "$.connectivity",
        "op": "type_is",
        "expected": "object"
      }
    ]
  }
}
