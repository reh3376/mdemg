        "type": "number"
      },
      {
        "path": "$.data.memory_md_lines",
        "type": "number"
      },
      {
        "path": "$.data.auto_memory_files",
        "type": "number"
      },
      {
        "path": "$.data.auto_memory_lines",
        "type": "number"
      },
      {
        "path": "$.data.overflow_events_24h",
        "type": "number"
      },
      {
        "path": "$.data.synergy_health",
        "type": "number"
      },
      {
        "path": "$.data.migration_status",
        "type": "string"
      }
    ]
  }
