{
  "uots_version": "1.0.0",
  "observability": {
    "name": "Neo4j Graph Alert Rules (Grafana Unified)",
    "type": "alert_rules",
    "tags": [
      "grafana",
      "alerts",
      "neo4j"
    ]
  },
  "target": {
    "file": "deploy/docker/grafana/provisioning/alerting/alerts.yml"
  },
  "expected": {
    "alerts": [
      {
        "name": "MDEMG Low Graph Health Score",
        "severity": "warning",
        "expr_contains": "neo4j_graph_health_score"
      },
      {
        "name": "MDEMG High Orphan Count",
        "severity": "warning",
        "expr_contains": "neo4j_graph_orphans"
      },
      {
        "name": "MDEMG High Orphan Ratio",
        "severity": "warning",
        "expr_contains": "neo4j_graph_orphans"
      },
      {
        "name": "MDEMG Neo4j High Memory Usage",
        "severity": "warning",
        "expr_contains": "neo4j_container_mem"
      },
      {
        "name": "MDEMG Neo4j High CPU Usage",
        "severity": "warning",
        "expr_contains": "neo4j_container_cpu_percent"
      },
      {
        "name": "MDEMG Significant Node Count Drop",
        "severity": "critical",
        "expr_contains": "neo4j_graph_nodes"
      }
    ]
  },
  "config": {
    "timeout_ms": 5000
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-16",
    "updated": "2026-06-11",
    "description": "Validates Neo4j graph health alert rules in Grafana Unified Alerting: correct alert titles, severity levels, SQL expressions. TSDB-CONSUME-001: the Connection Pool Exhausted rule was deleted \u2014 it read mdemg_neo4j_pool_waiting_requests, a perpetual zero from the fake pool gauges; it could never fire.",
    "status": "active",
    "tags": [
      "grafana",
      "alerts",
      "neo4j",
      "phase-grafana"
    ]
  }
}