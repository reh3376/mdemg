{
  "uots_version": "1.0.0",
  "observability": {
    "name": "Neo4j Graph Aggregate Metrics",
    "type": "metrics_snapshot",
    "tags": ["neo4j", "graph", "grafana-dashboard"]
  },
  "target": {
    "endpoint": "/v1/metrics/snapshot",
    "method": "GET"
  },
  "expected": {
    "metrics": [
      {
        "name": "mdemg_neo4j_graph_total_nodes",
        "type": "gauge",
        "help_contains": "Total nodes",
        "value_range": { "min": 0 }
      },
      {
        "name": "mdemg_neo4j_graph_total_edges",
        "type": "gauge",
        "help_contains": "Total edges",
        "value_range": { "min": 0 }
      },
      {
        "name": "mdemg_neo4j_graph_total_spaces",
        "type": "gauge",
        "help_contains": "Total number",
        "value_range": { "min": 0 }
      }
    ]
  },
  "config": {
    "timeout_ms": 10000,
    "base_url": "${MDEMG_BASE_URL}"
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-16",
    "updated": "2026-03-27",
    "description": "Validates that the metrics snapshot endpoint exposes aggregate Neo4j graph metrics. Per-space metrics (nodes, edges, orphans, health_score) are TSDB-only and not in the in-memory snapshot.",
    "status": "active",
    "tags": ["neo4j", "grafana-dashboard", "phase-grafana"]
  }
}
