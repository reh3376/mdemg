{
  "uots_version": "1.0.0",
  "observability": {
    "name": "TSDB pgx Connection Pool Metrics",
    "type": "metrics_snapshot",
    "tags": [
      "tsdb",
      "pool",
      "connections"
    ]
  },
  "target": {
    "endpoint": "/v1/metrics/snapshot",
    "method": "GET"
  },
  "expected": {
    "metrics": [
      {
        "name": "mdemg_tsdb_pool_total_conns",
        "type": "gauge",
        "help_contains": "Total",
        "value_range": {
          "min": 0
        }
      },
      {
        "name": "mdemg_tsdb_pool_idle_conns",
        "type": "gauge",
        "help_contains": "Idle",
        "value_range": {
          "min": 0
        }
      },
      {
        "name": "mdemg_tsdb_pool_acquired_conns",
        "type": "gauge",
        "help_contains": "checked out",
        "value_range": {
          "min": 0
        }
      },
      {
        "name": "mdemg_tsdb_pool_max_conns",
        "type": "gauge",
        "help_contains": "capacity",
        "value_range": {
          "min": 0
        }
      },
      {
        "name": "mdemg_tsdb_pool_empty_acquire_total",
        "type": "gauge",
        "help_contains": "empty pool",
        "value_range": {
          "min": 0
        }
      }
    ]
  },
  "config": {
    "timeout_ms": 5000,
    "base_url": "${MDEMG_BASE_URL}"
  },
  "metadata": {
    "author": "claude",
    "created": "2026-02-16",
    "description": "Validates that TSDB pgx connection pool metrics are exposed via the metrics snapshot endpoint. TSDB-CONSUME-001 replaced the fake mdemg_neo4j_pool_* gauges (the neo4j driver has no pool-stats API; the old values were a VerifyConnectivity probe counter and perpetual zeros) with real pgxpool.Stat() values.",
    "status": "active",
    "tags": [
      "tsdb",
      "pool",
      "tsdb-consume-001"
    ],
    "updated": "2026-06-11"
  }
}