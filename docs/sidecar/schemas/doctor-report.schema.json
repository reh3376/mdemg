{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdemg.dev/schemas/sidecar/doctor-report/v1.0.0",
  "title": "MDEMG Sidecar Doctor Report",
  "description": "Machine-readable report emitted by `mdemg sidecar doctor --format json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "timestamp",
    "result",
    "exit_code",
    "state_before",
    "state_after",
    "changes",
    "issues",
    "next_actions",
    "profile",
    "checks",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "command": {
      "const": "mdemg sidecar doctor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": ["success", "warning", "error"]
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 2, 3, 4, 5, 6]
    },
    "state_before": {
      "$ref": "#/$defs/sidecar_state"
    },
    "state_after": {
      "$ref": "#/$defs/sidecar_state"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "description": "Normalized issue list; no doctor-only finding may exist outside this field."
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "string",
      "enum": ["local", "studio-remote"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "Individual diagnostics executed by doctor.",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "warn", "fail", "skip"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sidecar_state": {
      "type": "string",
      "enum": [
        "uninitialized",
        "initialized",
        "installed",
        "running",
        "degraded",
        "stopped",
        "uninstalled"
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "backup_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "remediation"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error", "critical"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "message", "duration_ms"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "fail", "skip"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
