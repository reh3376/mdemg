  "sampling_group": "C",
  "prompt": {
    "system_prompt_hash": "0a82506152827fef03fc7fe7bfa6715e55c3391926549978c7d3e311b5a26832",
    "system_prompt_source": "internal/jiminy/codegen.go:15",
    "think_mode": false,
    "dynamic_prompt": false
