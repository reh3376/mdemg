{
  "ults_version": "1.0.0",
  "task": {
    "name": "jiminy.codegen",
    "description": "Constraint code generator \u2014 creates short mnemonic kebab-case codes for Jiminy constraints",
    "version": "1.0.0"
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-30",
    "priority": "low",
    "notes": "Static system prompt defines code generation task. User message contains only task inputs (constraintType, description, existingCodes). Output is a single string, not JSON."
