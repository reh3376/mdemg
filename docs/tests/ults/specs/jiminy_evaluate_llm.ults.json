{
  "ults_version": "1.0.0",
  "task": {
    "name": "jiminy.evaluate_llm",
    "description": "LLM-based constraint compliance evaluator — same as jiminy.evaluate but called via evaluator.go path",
    "version": "1.0.0"
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-03-30",
    "priority": "critical",
