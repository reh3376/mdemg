  },
  "sampling_group": "J",
  "prompt": {
    "system_prompt_hash": [
      "d8f4e2375bf11888445e3a0fad59802ebfb9bb9ef9bc527aee25c8c7e0a2a787",
      "1f02ee469728a422bd8e83629764be1a31115a02f7fbb5a372ef64243fb76bea"
