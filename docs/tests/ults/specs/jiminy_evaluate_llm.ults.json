          "properties": {
            "constraint_node_id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            },
            "remediation": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "constraint_node_id",
            "description",
            "reasoning",
            "remediation"
          ],
          "properties": {
            "constraint_node_id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            },
            "remediation": {
              "type": "string"
            }
          }
        }
      }
    }
