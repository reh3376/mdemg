    {
      "title": "Avg Time Between Compactions",
      "description": "Average interval between Claude auto-compact events (pre-compact hook → compact_event_ts). Computed over DISTINCT event timestamps of the LAST 10 events regardless of dashboard window — compactions are rare (days apart), so a windowed query read 'no value' on any range narrower than ~2 events, and the gauge's repeated flush rows previously inflated COUNT(*) (interval understated). LONGER is BETTER: frequent compaction means context pressure. Fixed 2026-07-21 during the operator's J17 dashboard investigation.",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 360
              },
              {
                "color": "green",
                "value": 1440
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawSql": "-- distinct compact events, last 10 lifetime (rare-event stream; no window filter)\nWITH ev AS (\n  SELECT DISTINCT value FROM metric_samples\n  WHERE metric_name = 'mdemg_compact_event_ts' AND metric_type = 'gauge'\n    AND space_id = '$space_id' AND value > 0\n  ORDER BY value DESC LIMIT 10\n)\nSELECT (MAX(value) - MIN(value)) / NULLIF(COUNT(*) - 1, 0) / 60.0 AS value FROM ev",
          "refId": "A"
        }
      ]
    },
