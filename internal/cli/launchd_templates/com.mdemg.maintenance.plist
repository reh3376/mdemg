<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mdemg.maintenance</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MDEMG_BIN__</string>
        <string>maintenance</string>
        <string>--space-id</string>
        <string>__SPACE_ID__</string>
        <!-- MAINT-LIVE-001: scheduled runs execute for real. The CLI default
             stays --dry-run=true for safe manual previews; the SCHEDULE is
             the thing that must not silently no-op. -->
        <string>--dry-run=false</string>
        <!-- Orphan disposition is context-dependent (operator, 2026-06-11):
             constraint = governance rules, never auto-tombstoned;
             conversation_observation = history vs test junk differ by
             SESSION, which the knob can't express yet — conservative
             exclusion. Aged hierarchy debris (concept/leaf/emergent_concept)
             stays eligible: that's the lifecycle working. -->
        <string>--exclude-role-types</string>
        <string>constraint,conversation_observation</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>StartInterval</key>
    <integer>604800</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.mdemg/logs/maintenance.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.mdemg/logs/maintenance.log</string>
</dict>
</plist>
