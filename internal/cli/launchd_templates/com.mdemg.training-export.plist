<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mdemg.training-export</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MDEMG_BIN__</string>
        <string>data</string>
        <string>export-auto</string>
        <string>--space-id</string>
        <string>__SPACE_ID__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>StartInterval</key>
    <integer>86400</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.mdemg/logs/training-export.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.mdemg/logs/training-export.log</string>
</dict>
</plist>
