# Maintainer: reh3376 <reh3376@users.noreply.github.com>
pkgname=mdemg
pkgver=0.2.16
pkgrel=1
pkgdesc="Multi-Dimensional Emergent Memory Graph — cognitive substrate for AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/reh3376/mdemg"
license=('MIT')
depends=('docker')
optdepends=('jq: JSON processing' 'curl: installer and API access')
source_x86_64=("https://github.com/reh3376/mdemg/releases/download/v${pkgver}/mdemg_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/reh3376/mdemg/releases/download/v${pkgver}/mdemg_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 mdemg "$pkgdir/usr/bin/mdemg"
    install -Dm644 systemd/mdemg.service "$pkgdir/usr/lib/systemd/system/mdemg@.service"
    install -Dm644 systemd/mdemg-rsic.service "$pkgdir/usr/lib/systemd/system/mdemg-rsic@.service"
    install -Dm644 systemd/mdemg-rsic.timer "$pkgdir/usr/lib/systemd/system/mdemg-rsic@.timer"

    # Man pages
    for f in man/man1/*.1; do
        [ -f "$f" ] || continue
        install -Dm644 "$f" "$pkgdir/usr/share/man/man1/$(basename "$f")"
    done

    # UxTS plugin manifest
    if [ -f plugins/uxts-module/manifest.json ]; then
        install -Dm644 plugins/uxts-module/manifest.json \
            "$pkgdir/usr/share/mdemg/plugins/uxts-module/manifest.json"
    fi

    # License
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
